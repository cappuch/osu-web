{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bash osu.Web/vercel-build.sh",
  "installCommand": "echo 'No package install required'",
  "outputDirectory": "osu.Web/dist/wwwroot",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" },
        { "key": "Cross-Origin-Resource-Policy", "value": "same-origin" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Permissions-Policy", "value": "fullscreen=(self)" }
      ]
    },
    {
      "source": "/_framework/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "functions": {
    "api/proxy/**/*.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/__proxy/:host/:path*", "destination": "/api/proxy/:host/:path*" }
  ]
}
