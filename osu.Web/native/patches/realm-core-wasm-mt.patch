+ExternalCommitHelper::ExternalCommitHelper(RealmCoordinator& parent, const RealmConfig&)
+    : m_parent(parent)
+{
+    m_thread = std::thread([this] {
+        std::unique_lock<std::mutex> lock(m_mutex);
+        while (true) {
+            m_cv.wait(lock, [this] {
+                return m_pending || m_stop;
+            });
+            if (m_stop)
+                return;
+            m_pending = false;
+            lock.unlock();
+            m_parent.on_change();
+            lock.lock();
+        }
+    });
