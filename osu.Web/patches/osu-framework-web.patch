+// Copyright (c) ppy Pty Ltd <contact@ppy.sh>. Licensed under the MIT Licence.
+// See the LICENCE file in the repository root for full licence text.
+
+#if OSU_WEB
+
+using System.Runtime.InteropServices;
+using System.Runtime.InteropServices.JavaScript;
+using System.Runtime.Versioning;
+
+namespace osu.Framework.Platform.Web
+{
+    /// <summary>
+    /// Native (Emscripten JS library, see <c>osuweb.js</c>) functions. These run on the calling thread (i.e. the game thread's web worker).
+    /// </summary>
+    internal static class WebNative
+    {
+        private const string lib = "osuweb";
+
+        /// <summary>
+        /// Creates a WebGL2 context on an OffscreenCanvas owned by the calling thread and makes it current.
+        /// </summary>
+        [DllImport(lib)]
+        public static extern int osuweb_gl_create(int width, int height);
+
+        [DllImport(lib)]
+        public static extern void osuweb_gl_resize(int width, int height);
+
+        /// <summary>
+        /// Destroys the current WebGL context and releases its canvas.
+        /// </summary>
+        [DllImport(lib)]
+        public static extern void osuweb_gl_destroy();
+
+        /// <summary>
+        /// Flushes the WebGL commands for the frame already drawn into the page canvas.
+        /// </summary>
+        [DllImport(lib)]
+        public static extern void osuweb_gl_present();
+
+        /// <summary>
+        /// Waits for the page's next animation frame. Does not allocate.
+        /// </summary>
+        [DllImport(lib)]
+        public static extern void osuweb_wait_vsync();
+
+        /// <summary>
+        /// Installs <c>globalThis.osuweb</c> in the calling worker, forwarding page calls to the browser's main thread.
+        /// Must be called on the game thread before any <see cref="WebHostInterop"/> call.
+        /// </summary>
+        [DllImport(lib)]
+        public static extern void osuweb_worker_init(int sampleRate);
+    }
+
+    /// <summary>
+    /// Functions of the game thread's own worker (installed by <see cref="WebNative.osuweb_worker_init"/>).
+    /// </summary>
+    [SupportedOSPlatform("browser")]
+    internal static partial class WebWorkerInterop
+    {
+        /// <summary>
+        /// Completes once the page has transferred its visible canvas (or selected bitmap fallback) to this worker.
+        /// </summary>
+        [JSImport("globalThis.osuweb.waitForDisplay")]
+        public static partial System.Threading.Tasks.Task WaitForDisplay();
+
+        /// <summary>
+        /// Yields to the worker's event loop, paced by the browser when bitmap presentation is in use.
+        /// </summary>
+        [JSImport("globalThis.osuweb.nextFrame")]
+        public static partial System.Threading.Tasks.Task NextFrame();
+    }
+
+    /// <summary>
+    /// Functions implemented by the page (<c>globalThis.osuweb</c>). On the game thread these resolve to the worker's forwarding shim.
+    /// </summary>
+    [SupportedOSPlatform("browser")]
+    internal static partial class WebHostInterop
+    {
+        [JSImport("globalThis.osuweb.openUrl")]
+        public static partial void OpenUrl(string url);
+
+        [JSImport("globalThis.osuweb.proxyUrl")]
+        public static partial string ProxyUrl(string url);
+
+        [JSImport("globalThis.osuweb.setTitle")]
+        public static partial void SetTitle(string title);
+
+        [JSImport("globalThis.osuweb.setCursorVisible")]
+        public static partial void SetCursorVisible(bool visible);
+
+        [JSImport("globalThis.osuweb.setPointerLock")]
+        public static partial void SetPointerLock(bool locked);
+
+        [JSImport("globalThis.osuweb.setFullscreen")]
+        public static partial void SetFullscreen(bool fullscreen);
+
+        [JSImport("globalThis.osuweb.getClipboardText")]
+        public static partial string GetClipboardText();
+
+        [JSImport("globalThis.osuweb.setClipboardText")]
+        public static partial void SetClipboardText(string text);
+
+        [JSImport("globalThis.osuweb.setTextInputActive")]
+        public static partial void SetTextInputActive(bool active);
+
+        [JSImport("globalThis.osuweb.syncStorage")]
+        public static partial void SyncStorage();
+
+        [JSImport("globalThis.osuweb.onGameReady")]
+        public static partial void OnGameReady();
+    }
+}
+
+#endif
