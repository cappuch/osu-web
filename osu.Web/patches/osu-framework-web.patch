@@ -0,0 +1,145 @@
+// Copyright (c) ppy Pty Ltd <contact@ppy.sh>. Licensed under the MIT Licence.
+// See the LICENCE file in the repository root for full licence text.
+
+#if OSU_WEB
+
+using System;
+using System.Collections.Generic;
+using System.Runtime.Versioning;
+using osu.Framework.Configuration;
+using osu.Framework.Graphics.OpenGL;
+using osu.Framework.Graphics.Video;
+using osu.Framework.Input;
+using osu.Framework.Input.Handlers;
+using osu.Framework.Logging;
+using SixLabors.ImageSharp;
+using SixLabors.ImageSharp.PixelFormats;
+
+namespace osu.Framework.Platform.Web
+{
+    /// <summary>
+    /// A <see cref="GameHost"/> for running inside a web browser (WebAssembly + WebGL2).
+    /// </summary>
+    /// <remarks>
+    /// Must be created and run on a JSWebWorker thread (a worker with its own JS event loop), using <see cref="RunAsync"/>.
+    /// All game threads are executed on that thread (<see cref="ExecutionMode.SingleThread"/>), as the WebGL context is bound to it.
+    /// </remarks>
+    [SupportedOSPlatform("browser")]
+    public class WebGameHost : GameHost
+    {
+        /// <summary>
+        /// The root of the (persistent) virtual filesystem mount provided by the page.
+        /// </summary>
+        public const string STORAGE_ROOT = "/data";
+
+        /// <param name="gameName">The name of the game.</param>
+        /// <param name="sampleRate">The page's audio output sample rate, which the game thread cannot query synchronously.</param>
+        /// <param name="options">Host options.</param>
+        public WebGameHost(string gameName, int sampleRate, HostOptions? options = null)
+            : base(gameName, options)
+        {
+            WebWindow.WorkerContext = System.Threading.SynchronizationContext.Current
+                                      ?? throw new InvalidOperationException($"{nameof(WebGameHost)} must be created on a JSWebWorker thread.");
+            WebNative.osuweb_worker_init(sampleRate);
+        }
+
+        /// <summary>
+        /// Runs the game, completing when it exits.
+        /// </summary>
+        public async System.Threading.Tasks.Task RunAsync(Game game)
+        {
+            // Yield once so the page can transfer its visible OffscreenCanvas to this JS worker before renderer setup.
+            await WebWorkerInterop.WaitForDisplay().ConfigureAwait(true);
+            Run(game);
+            await WebRunCompletion.ConfigureAwait(false);
+        }
+
+        protected override IWindow CreateWindow(GraphicsSurfaceType preferredSurface) => new WebWindow();
+
+        protected override Clipboard CreateClipboard() => new WebClipboard();
+
+        protected override void ChooseAndSetupRenderer() => SetupRendererAndWindow(new GLRenderer(), GraphicsSurfaceType.OpenGL);
+
+        protected override void SetupConfig(IDictionary<FrameworkSetting, object> defaultOverrides)
+        {
+            defaultOverrides[FrameworkSetting.ExecutionMode] = ExecutionMode.SingleThread;
+
+            base.SetupConfig(defaultOverrides);
+
+            // The WebGL context is bound to a single thread, so multi-threaded execution isn't possible.
+            var executionMode = Config.GetBindable<ExecutionMode>(FrameworkSetting.ExecutionMode);
+            executionMode.Value = ExecutionMode.SingleThread;
+            executionMode.Disabled = true;
+
+            // FFmpeg's native hardware-device backends cannot access the browser's GPU/video decoder. Probing them
+            // only adds failed setup work and can leave video playback slower than explicit software decoding.
+            Config.GetBindable<HardwareVideoDecoder>(FrameworkSetting.HardwareVideoDecoder).Value = HardwareVideoDecoder.None;
+        }
+
+        protected override TextInputSource CreateTextInput() => Window is WebWindow window ? new WebTextInput(window) : base.CreateTextInput();
+
+        public override Storage GetStorage(string path) => new NativeStorage(path, this);
+
+        public override IEnumerable<string> UserStoragePaths => new[] { STORAGE_ROOT };
+
+        public override bool OpenFileExternally(string filename)
+        {
+            Logger.Log($"Opening files externally is not supported in the browser ({filename}).");
+            return false;
+        }
+
+        public override bool PresentFileExternally(string filename)
+        {
+            Logger.Log($"Presenting files externally is not supported in the browser ({filename}).");
+            return false;
+        }
+
+        public override void OpenUrlExternally(string url) => WebHostInterop.OpenUrl(url);
+
+        protected override IEnumerable<InputHandler> CreateAvailableInputHandlers() => new InputHandler[]
+        {
+            new WebKeyboardHandler(),
+            new WebMouseHandler(),
+            new WebTouchHandler(),
+        };
+    }
+
+    [SupportedOSPlatform("browser")]
+    public class WebClipboard : Clipboard
+    {
+        private string? localText;
+
+        public override string? GetText()
+        {
+            try
+            {
+                return WebHostInterop.GetClipboardText();
+            }
+            catch (Exception e)
+            {
+                Logger.Log($"Failed to read the clipboard: {e.Message}");
+                return localText;
+            }
+        }
+
+        public override void SetText(string text)
+        {
+            localText = text;
+
+            try
+            {
+                WebHostInterop.SetClipboardText(text);
+            }
+            catch (Exception e)
+            {
+                Logger.Log($"Failed to write the clipboard: {e.Message}");
+            }
+        }
+
+        public override Image<TPixel>? GetImage<TPixel>() => null;
+
+        public override bool SetImage(Image image) => false;
+    }
+}
+
+#endif
diff --git a/osu.Framework/Platform/Web/WebInput.cs b/osu.Framework/Platform/Web/WebInput.cs
new file mode 100644
index 000000000..d29a9819b
--- /dev/null
+++ b/osu.Framework/Platform/Web/WebInput.cs
@@ -0,0 +1,261 @@
+// Copyright (c) ppy Pty Ltd <contact@ppy.sh>. Licensed under the MIT Licence.
+// See the LICENCE file in the repository root for full licence text.
+
+#if OSU_WEB
+
+using System;
+using System.IO;
+using System.Runtime.InteropServices.JavaScript;
+using System.Runtime.Versioning;
+
+namespace osu.Framework.Platform.Web
+{
+    internal enum WebEventType
+    {
+        Resize,
+        MouseMove,
+        MouseMoveRelative,
+        MouseDown,
+        MouseUp,
+        MouseWheel,
+        MouseEnter,
+        MouseLeave,
+        KeyDown,
+        KeyUp,
+        TextInput,
+        TouchStart,
+        TouchMove,
+        TouchEnd,
+        Focus,
+        Blur,
+        Visibility,
+        FileDrop,
+        Fullscreen,
+    }
+
+    internal readonly struct WebEvent
+    {
+        public readonly WebEventType Type;
+        public readonly float X;
+        public readonly float Y;
+        public readonly float Z;
+        public readonly int A;
+        public readonly string? Text;
+
+        public WebEvent(WebEventType type, float x = 0, float y = 0, float z = 0, int a = 0, string? text = null)
+        {
+            Type = type;
+            X = x;
+            Y = y;
+            Z = z;
+            A = a;
+            Text = text;
+        }
+    }
+
+    /// <summary>
+    /// Entry points invoked by the page's event listeners (on the browser main thread).
+    /// Events are queued and later processed on the game thread by <see cref="WebWindow"/>.
+    /// </summary>
+    /// <remarks>
+    /// Coordinates are in device pixels, relative to the top-left of the game canvas.
+    /// </remarks>
+    [SupportedOSPlatform("browser")]
+    public static partial class WebInput
+    {
+        // Keep input memory bounded if the game thread stalls (shader compilation, GC, context loss, etc.).
+        // Motion events are state updates and may be coalesced without losing button/key transitions.
+        private const int max_pending_events = 4096;
+
+        private static readonly object events_lock = new object();
+        private static readonly WebEvent[] pending_events = new WebEvent[max_pending_events];
+        private static int pending_head;
+        private static int pending_count;
+
+        internal static bool TryDequeue(out WebEvent e)
+        {
+            lock (events_lock)
+            {
+                if (pending_count == 0)
+                {
+                    e = default;
+                    return false;
+                }
+
+                e = pending_events[pending_head];
+                pending_events[pending_head] = default;
+                pending_head = (pending_head + 1) % max_pending_events;
+                pending_count--;
+                return true;
+            }
+        }
+
+        internal static void Clear()
+        {
+            lock (events_lock)
+            {
+                for (int i = 0; i < pending_count; i++)
+                    Discard(pending_events[indexAt(i)]);
+
+                Array.Clear(pending_events);
+                pending_head = 0;
+                pending_count = 0;
+            }
+        }
+
+        /// <summary>
+        /// Releases resources owned by an event which will not be delivered.
+        /// </summary>
+        internal static void Discard(WebEvent e)
+        {
+            if (e.Type != WebEventType.FileDrop || string.IsNullOrEmpty(e.Text))
+                return;
+
+            try
+            {
+                File.Delete(e.Text);
+            }
+            catch
+            {
+                // The file may already have been claimed/deleted by the game or the virtual filesystem may be shutting down.
+            }
+        }
+
+        private static void enqueue(WebEvent e)
+        {
+            lock (events_lock)
+            {
+                if (tryCoalesceWithTail(e))
+                    return;
+
+                if (pending_count == max_pending_events)
+                {
+                    // Prefer dropping an obsolete state update over an edge event. This also keeps retained
+                    // strings (text input and file paths) strictly bounded when the game cannot drain input.
+                    int offset = 0;
+                    while (offset < pending_count && !isCoalescable(pending_events[indexAt(offset)].Type))
+                        offset++;
+
+                    removeAt(offset < pending_count ? offset : 0);
+                }
+
+                pending_events[indexAt(pending_count)] = e;
+                pending_count++;
+            }
+        }
+
+        private static bool tryCoalesceWithTail(WebEvent e)
+        {
+            if (pending_count == 0)
+                return false;
+
+            int tailIndex = indexAt(pending_count - 1);
+            WebEvent previous = pending_events[tailIndex];
+            if (previous.Type != e.Type)
+                return false;
+
+            switch (e.Type)
+            {
+                case WebEventType.Resize:
+                case WebEventType.MouseMove:
+                    pending_events[tailIndex] = e;
+                    return true;
+
+                case WebEventType.MouseMoveRelative:
+                    pending_events[tailIndex] = new WebEvent(e.Type, previous.X + e.X, previous.Y + e.Y);
+                    return true;
+
+                case WebEventType.MouseWheel when previous.A == e.A:
+                    pending_events[tailIndex] = new WebEvent(e.Type, previous.X + e.X, previous.Y + e.Y, a: e.A);
+                    return true;
+
+                case WebEventType.TouchMove when previous.A == e.A:
+                    pending_events[tailIndex] = e;
+                    return true;
+
+                case WebEventType.Visibility:
+                    pending_events[tailIndex] = e;
+                    return true;
+
+                default:
+                    return false;
+            }
+        }
+
+        private static int indexAt(int offset) => (pending_head + offset) % max_pending_events;
+
+        private static void removeAt(int offset)
+        {
+            Discard(pending_events[indexAt(offset)]);
+
+            for (int i = offset; i < pending_count - 1; i++)
+                pending_events[indexAt(i)] = pending_events[indexAt(i + 1)];
+
+            pending_events[indexAt(pending_count - 1)] = default;
+            pending_count--;
+        }
+
+        private static bool isCoalescable(WebEventType type) => type is
+            WebEventType.Resize or
+            WebEventType.MouseMove or
+            WebEventType.MouseMoveRelative or
+            WebEventType.MouseWheel or
+            WebEventType.TouchMove or
+            WebEventType.Visibility;
+
+        [JSExport]
+        public static void Resize(int width, int height, double scale, int refreshRate)
+            => enqueue(new WebEvent(WebEventType.Resize, width, height, (float)scale, refreshRate));
+
+        [JSExport]
+        public static void MouseMove(double x, double y) => enqueue(new WebEvent(WebEventType.MouseMove, (float)x, (float)y));
+
+        [JSExport]
+        public static void MouseMoveRelative(double dx, double dy) => enqueue(new WebEvent(WebEventType.MouseMoveRelative, (float)dx, (float)dy));
+
+        /// <param name="button">The DOM <c>MouseEvent.button</c> value.</param>
+        /// <param name="down">Whether the button was pressed.</param>
+        [JSExport]
+        public static void MouseButton(int button, bool down) => enqueue(new WebEvent(down ? WebEventType.MouseDown : WebEventType.MouseUp, a: button));
+
+        /// <param name="dx">Horizontal scroll, in "lines" (positive = right).</param>
+        /// <param name="dy">Vertical scroll, in "lines" (positive = up).</param>
+        /// <param name="precise">Whether this is a high-precision (touchpad / pixel mode) scroll.</param>
+        [JSExport]
+        public static void MouseWheel(double dx, double dy, bool precise) => enqueue(new WebEvent(WebEventType.MouseWheel, (float)dx, (float)dy, a: precise ? 1 : 0));
+
+        [JSExport]
+        public static void MouseInWindow(bool inWindow) => enqueue(new WebEvent(inWindow ? WebEventType.MouseEnter : WebEventType.MouseLeave));
+
+        /// <param name="code">The DOM <c>KeyboardEvent.code</c> value.</param>
+        /// <param name="down">Whether the key was pressed.</param>
+        [JSExport]
+        public static void Key(string code, bool down) => enqueue(new WebEvent(down ? WebEventType.KeyDown : WebEventType.KeyUp, text: code));
+
+        [JSExport]
+        public static void TextInput(string text) => enqueue(new WebEvent(WebEventType.TextInput, text: text));
+
+        /// <param name="id">The DOM <c>Touch.identifier</c>.</param>
+        /// <param name="x">X position.</param>
+        /// <param name="y">Y position.</param>
+        /// <param name="phase">0 = start, 1 = move, 2 = end/cancel.</param>
+        [JSExport]
+        public static void Touch(int id, double x, double y, int phase)
+            => enqueue(new WebEvent(phase == 0 ? WebEventType.TouchStart : phase == 1 ? WebEventType.TouchMove : WebEventType.TouchEnd, (float)x, (float)y, a: id));
+
+        [JSExport]
+        public static void Focus(bool focused) => enqueue(new WebEvent(focused ? WebEventType.Focus : WebEventType.Blur));
+
+        [JSExport]
+        public static void Visibility(bool visible) => enqueue(new WebEvent(WebEventType.Visibility, a: visible ? 1 : 0));
+
+        [JSExport]
+        public static void Fullscreen(bool fullscreen) => enqueue(new WebEvent(WebEventType.Fullscreen, a: fullscreen ? 1 : 0));
+
+        /// <param name="path">The path of a file (already written to the virtual filesystem by the page) which was dropped onto the game.</param>
+        [JSExport]
+        public static void FileDrop(string path) => enqueue(new WebEvent(WebEventType.FileDrop, text: path));
+    }
+}
+
+#endif
diff --git a/osu.Framework/Platform/Web/WebInputHandlers.cs b/osu.Framework/Platform/Web/WebInputHandlers.cs
new file mode 100644
index 000000000..64c97f784
--- /dev/null
+++ b/osu.Framework/Platform/Web/WebInputHandlers.cs
@@ -0,0 +1,232 @@
+// Copyright (c) ppy Pty Ltd <contact@ppy.sh>. Licensed under the MIT Licence.
+// See the LICENCE file in the repository root for full licence text.
+
+#if OSU_WEB
+
+using System.Collections.Generic;
+using System.Runtime.Versioning;
+using osu.Framework.Input;
+using osu.Framework.Input.Handlers;
+using osu.Framework.Input.StateChanges;
+using osu.Framework.Statistics;
+using osuTK;
+using osuTK.Input;
+
+namespace osu.Framework.Platform.Web
+{
+    [SupportedOSPlatform("browser")]
+    public class WebMouseHandler : InputHandler
+    {
+        public override string Description => "Mouse";
+
+        public override bool IsActive => true;
+
+        public override bool Initialize(GameHost host)
+        {
+            if (!base.Initialize(host))
+                return false;
+
+            if (host.Window is not WebWindow window)
+                return false;
+
+            Enabled.BindValueChanged(e =>
+            {
+                if (e.NewValue)
+                {
+                    window.MouseMove += handleMouseMove;
+                    window.MouseDown += handleMouseDown;
+                    window.MouseUp += handleMouseUp;
+                    window.MouseWheel += handleMouseWheel;
+                }
+                else
+                {
+                    window.MouseMove -= handleMouseMove;
+                    window.MouseDown -= handleMouseDown;
+                    window.MouseUp -= handleMouseUp;
+                    window.MouseWheel -= handleMouseWheel;
+                }
+            }, true);
+
+            return true;
+        }
+
+        private void enqueue(IInput input)
+        {
+            PendingInputs.Enqueue(input);
+            FrameStatistics.Increment(StatisticsCounterType.MouseEvents);
+        }
+
+        private void handleMouseMove(Vector2 position) => enqueue(new MousePositionAbsoluteInput { Position = position });
+
+        private void handleMouseDown(MouseButton button) => enqueue(new MouseButtonInput(button, true));
+
+        private void handleMouseUp(MouseButton button) => enqueue(new MouseButtonInput(button, false));
+
+        private void handleMouseWheel(Vector2 delta, bool precise) => enqueue(new MouseScrollRelativeInput { Delta = delta, IsPrecise = precise });
+    }
+
+    [SupportedOSPlatform("browser")]
+    public class WebKeyboardHandler : InputHandler
+    {
+        public override string Description => "Keyboard";
+
+        public override bool IsActive => true;
+
+        public override bool Initialize(GameHost host)
+        {
+            if (!base.Initialize(host))
+                return false;
+
+            if (host.Window is not WebWindow window)
+                return false;
+
+            Enabled.BindValueChanged(e =>
+            {
+                if (e.NewValue)
+                {
+                    window.KeyDown += handleKeyDown;
+                    window.KeyUp += handleKeyUp;
+                }
+                else
+                {
+                    window.KeyDown -= handleKeyDown;
+                    window.KeyUp -= handleKeyUp;
+                }
+            }, true);
+
+            return true;
+        }
+
+        private void enqueue(IInput input)
+        {
+            PendingInputs.Enqueue(input);
+            FrameStatistics.Increment(StatisticsCounterType.KeyEvents);
+        }
+
+        private void handleKeyDown(Key key) => enqueue(new KeyboardKeyInput(key, true));
+
+        private void handleKeyUp(Key key) => enqueue(new KeyboardKeyInput(key, false));
+    }
+
+    [SupportedOSPlatform("browser")]
+    public class WebTouchHandler : InputHandler
+    {
+        public override string Description => "Touchscreen";
+
+        public override bool IsActive => true;
+
+        /// <summary>
+        /// Maps DOM touch identifiers to framework touch sources.
+        /// </summary>
+        private readonly Dictionary<int, TouchSource> sources = new Dictionary<int, TouchSource>();
+
+        public override bool Initialize(GameHost host)
+        {
+            if (!base.Initialize(host))
+                return false;
+
+            if (host.Window is not WebWindow window)
+                return false;
+
+            Enabled.BindValueChanged(e =>
+            {
+                if (e.NewValue)
+                {
+                    window.TouchDown += handleTouchDown;
+                    window.TouchMove += handleTouchMove;
+                    window.TouchUp += handleTouchUp;
+                }
+                else
+                {
+                    window.TouchDown -= handleTouchDown;
+                    window.TouchMove -= handleTouchMove;
+                    window.TouchUp -= handleTouchUp;
+                }
+            }, true);
+
+            return true;
+        }
+
+        private TouchSource? getSource(int id, bool allocate)
+        {
+            if (sources.TryGetValue(id, out var existing))
+                return existing;
+
+            if (!allocate)
+                return null;
+
+            for (var s = TouchSource.Touch1; s <= TouchSource.Touch10; s++)
+            {
+                if (!sources.ContainsValue(s))
+                {
+                    sources[id] = s;
+                    return s;
+                }
+            }
+
+            return null;
+        }
+
+        private void enqueue(IInput input)
+        {
+            PendingInputs.Enqueue(input);
+            FrameStatistics.Increment(StatisticsCounterType.TouchEvents);
+        }
+
+        private void handleTouchDown(int id, Vector2 position)
+        {
+            var source = getSource(id, true);
+            if (source != null)
+                enqueue(new TouchInput(new Touch(source.Value, position), true));
+        }
+
+        private void handleTouchMove(int id, Vector2 position)
+        {
+            var source = getSource(id, false);
+            if (source != null)
+                enqueue(new TouchInput(new Touch(source.Value, position), true));
+        }
+
+        private void handleTouchUp(int id, Vector2 position)
+        {
+            var source = getSource(id, false);
+            if (source == null)
+                return;
+
+            sources.Remove(id);
+            enqueue(new TouchInput(new Touch(source.Value, position), false));
+        }
+    }
+
+    [SupportedOSPlatform("browser")]
+    public class WebTextInput : TextInputSource
+    {
+        private readonly WebWindow window;
+
+        public WebTextInput(WebWindow window)
+        {
+            this.window = window;
+        }
+
+        protected override void ActivateTextInput(TextInputProperties properties)
+        {
+            window.TextInput += handleTextInput;
+            WebHostInterop.SetTextInputActive(true);
+        }
+
+        protected override void EnsureTextInputActivated(TextInputProperties properties)
+        {
+            WebHostInterop.SetTextInputActive(true);
+        }
+
+        protected override void DeactivateTextInput()
+        {
+            window.TextInput -= handleTextInput;
+            WebHostInterop.SetTextInputActive(false);
+        }
+
+        private void handleTextInput(string text) => TriggerTextInput(text);
+    }
+}
+
+#endif
