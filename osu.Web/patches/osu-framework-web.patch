+++ b/osu.Framework/Audio/Track/TrackWeb.cs
@@ -0,0 +1,488 @@
+// Copyright (c) ppy Pty Ltd <contact@ppy.sh>. Licensed under the MIT Licence.
+// See the LICENCE file in the repository root for full licence text.
+
+#if OSU_WEB
+
+using System;
+using System.IO;
+using System.Threading;
+using System.Threading.Tasks;
+using osu.Framework.Audio.Mixing.Web;
+using osu.Framework.Audio.Web;
+using osu.Framework.Extensions;
+using osu.Framework.Logging;
+
+namespace osu.Framework.Audio.Track
+{
+    /// <summary>
+    /// A track played through the <see cref="WebAudioEngine"/>, decoded in managed code.
+    /// </summary>
+    /// <remarks>
+    /// Audio is decoded progressively on a background thread. The track becomes loaded (with a known <see cref="Track.Length"/>) as soon as the
+    /// stream headers have been parsed; if playback reaches audio which hasn't been decoded yet it stalls (and time does not advance) until data is available.
+    /// </remarks>
+    public sealed class TrackWeb : Track, IWebAudioChannel
+    {
+        private const float tempo_minimum_supported = 0.05f;
+
+        /// <summary>
+        /// Guards all playback state, which is shared between the audio thread (and other callers) and the mixer thread.
+        /// </summary>
+        private readonly Lock stateLock = new Lock();
+
+        private readonly CancellationTokenSource decodeCancellation = new CancellationTokenSource();
+
+        private PcmData? pcm;
+        private PcmRenderer? renderer;
+
+        private volatile bool isLoaded;
+
+        public override bool IsLoaded => isLoaded;
+
+        /// <summary>
+        /// Whether playback has been requested (via <see cref="Start"/>) and not yet stopped or completed.
+        /// </summary>
+        private volatile bool isPlayed;
+
+        private volatile bool hasCompleted;
+
+        /// <summary>
+        /// A seek position requested before the track data was available.
+        /// </summary>
+        private double pendingSeek;
+
+        /// <summary>
+        /// The last position that a seek will succeed for.
+        /// </summary>
+        private double lastSeekablePosition;
+
+        private volatile int bitrate;
+
+        #region Mix state (guarded by stateLock)
+
+        private double frequency = 1;
+        private double tempo = 1;
+        private float gainLeft = 1;
+        private float gainRight = 1;
+        private GainRamp gainRamp;
+
+        /// <summary>
+        /// Whether the end of the track has been mixed, but not yet heard.
+        /// </summary>
+        private bool endPending;
+
+        /// <summary>
+        /// The output frame following the last frame of the track.
+        /// </summary>
+        private int endWriteFrame;
+
+        /// <summary>
+        /// Whether no audio has been mixed since playback last started or the position was changed.
+        /// </summary>
+        private bool playStartPending = true;
+
+        /// <summary>
+        /// The output frame at which the current continuous run of audio started.
+        /// Latency compensation never extends beyond this point, which keeps time from going backwards on start / seek / loop.
+        /// </summary>
+        private int playStartWriteFrame;
+
+        /// <summary>
+        /// The track time (in milliseconds) at the end of the most recently mixed audio.
+        /// </summary>
+        private double mixedTime;
+
+        /// <summary>
+        /// The output frame following the most recently mixed audio of this track.
+        /// </summary>
+        private int mixedWriteFrame;
+
+        /// <summary>
+        /// Track milliseconds per output frame for the most recently mixed audio.
+        /// </summary>
+        private double mixedMillisecondsPerFrame;
+
+        /// <summary>
+        /// The most recently reported <see cref="CurrentTime"/> during the current continuous run, used to suppress tiny regressions
+        /// resulting from floating-point error or rate changes (compensation uses the latest rate for all buffered audio).
+        /// </summary>
+        private double lastReportedTime = double.MinValue;
+
+        /// <summary>
+        /// The maximum regression in reported time which will be suppressed, in milliseconds.
+        /// </summary>
+        private const double max_suppressed_regression = 5;
+
+        #endregion
+
+        private AmplitudeAnalyser? amplitudeAnalyser;
+        private volatile bool amplitudesRequested;
+        private ChannelAmplitudes currentAmplitudes = ChannelAmplitudes.Empty;
+
+        /// <summary>
+        /// Constructs a new <see cref="TrackWeb"/> from provided audio data.
+        /// </summary>
+        /// <param name="data">The encoded audio data stream. The track takes ownership of the stream.</param>
+        /// <param name="name">A name identifying the track internally.</param>
+        internal TrackWeb(Stream data, string name)
+            : base(name)
+        {
+            ArgumentNullException.ThrowIfNull(data);
+
+            AggregateTempo.ValueChanged += t =>
+            {
+                if (t.NewValue < tempo_minimum_supported)
+                    throw new ArgumentException($"{nameof(TrackWeb)} does not support {nameof(Tempo)} specifications below {tempo_minimum_supported}. Use {nameof(Frequency)} instead.");
+            };
+
+            var token = decodeCancellation.Token;
+            Task.Run(() => load(data, token), token);
+
+            InvalidateState();
+        }
+
+        private void load(Stream data, CancellationToken token)
+        {
+            AudioDecoder decoder;
+
+            try
+            {
+                byte[] bytes;
+
+                using (data)
+                    bytes = AudioDecoder.ReadAllBytes(data);
+
+                decoder = AudioDecoder.Create(bytes);
+            }
+            catch (Exception e)
+            {
+                Logger.Log($"Failed to load track \"{Name}\": {e.Message}", level: LogLevel.Important);
+                return;
+            }
+
+            using (decoder)
+            {
+                var pcmData = decoder.CreatePcmData();
+
+                lock (stateLock)
+                {
+                    if (IsDisposed)
+                        return;
+
+                    pcm = pcmData;
+                    renderer = new PcmRenderer(pcmData);
+                    renderer.SetPosition(pendingSeek / 1000 * pcmData.SampleRate);
+                }
+
+                bitrate = decoder.Bitrate;
+
+                // Make the track available as early as possible if the length is known ahead of decoding.
+                if (pcmData.TotalFrames > 0)
+                    EnqueueAction(updateLength);
+
+                if (!decoder.DecodeInto(pcmData, token) && !token.IsCancellationRequested)
+                    Logger.Log($"Track \"{Name}\" could not be fully decoded (decoded {pcmData.LengthMilliseconds:N0}ms).", level: LogLevel.Important);
+
+                if (!token.IsCancellationRequested)
+                    EnqueueAction(updateLength);
+            }
+        }
+
+        private void updateLength()
+        {
+            var data = pcm;
+            if (data == null)
+                return;
+
+            long frames = data.TotalFrames;
+
+            Length = frames * 1000.0 / data.SampleRate;
+
+            // Match BASS, which does not allow seeking to the very end of the track.
+            lastSeekablePosition = Math.Max(0, frames - 1) * 1000.0 / data.SampleRate;
+
+            isLoaded = true;
+        }
+
+        public override bool IsDummyDevice => false;
+
+        public override int? Bitrate => bitrate;
+
+        public override bool IsRunning => isPlayed;
+
+        public override bool HasCompleted => hasCompleted;
+
+        public override double CurrentTime
+        {
+            get
+            {
+                lock (stateLock)
+                    return getCurrentTime();
+            }
+        }
+
+        /// <summary>
+        /// Computes the audible time, compensating for audio which has been mixed but not yet played. Must be called under <see cref="stateLock"/>.
+        /// </summary>
+        private double getCurrentTime()
+        {
+            if (renderer == null || pcm == null)
+                return pendingSeek;
+
+            if ((!isPlayed && !endPending) || playStartPending)
+                return renderer.Position * 1000 / pcm.SampleRate;
+
+            int readFrame = WebAudioEngine.ReadFrame;
+
+            int unplayed = unchecked(mixedWriteFrame - readFrame);
+            int sinceStart = unchecked(mixedWriteFrame - playStartWriteFrame);
+            unplayed = Math.Clamp(unplayed, 0, Math.Max(0, sinceStart));
+
+            double time = Math.Max(0, mixedTime - unplayed * mixedMillisecondsPerFrame);
+
+            if (time < lastReportedTime && lastReportedTime - time < max_suppressed_regression)
+                time = lastReportedTime;
+
+            return lastReportedTime = time;
+        }
+
+        public override void Start()
+        {
+            ObjectDisposedException.ThrowIf(IsDisposed, this);
+
+            StartAsync().WaitSafely();
+        }
+
+        public override Task StartAsync() => EnqueueAction(() =>
+        {
+            lock (stateLock)
+            {
+                // Block restarting when at the end, matching TrackBass.
+                if (hasCompleted || isPlayed)
+                    return;
+
+                isPlayed = true;
+                playStartPending = true;
+                lastReportedTime = double.MinValue;
+            }
+        });
+
+        public override void Stop() => StopAsync().WaitSafely();
+
+        public override Task StopAsync() => EnqueueAction(() =>
+        {
+            lock (stateLock)
+            {
+                if (!isPlayed)
+                    return;
+
+                // Rewind to the audible position, such that time is continuous and playback resumes from where it was heard.
+                if (renderer != null && pcm != null && !playStartPending)
+                    renderer.SetPosition(getCurrentTime() / 1000 * pcm.SampleRate);
+
+                isPlayed = false;
+                endPending = false;
+                playStartPending = true;
+            }
+        });
+
+        public override bool Seek(double seek) => SeekAsync(seek).GetResultSafely();
+
+        public override async Task<bool> SeekAsync(double seek)
+        {
+            // At this point the track may not yet be loaded which is indicated by a 0 length.
+            // In that case we still want to return true, hence the conservative length.
+            double conservativeLength = Length == 0 ? double.MaxValue : lastSeekablePosition;
+            double conservativeClamped = Math.Clamp(seek, 0, conservativeLength);
+
+            await EnqueueAction(() => seekInternal(seek)).ConfigureAwait(false);
+
+            return conservativeClamped == seek;
+        }
+
+        private void seekInternal(double seek)
+        {
+            lock (stateLock)
+            {
+                double clamped = Math.Clamp(seek, 0, Length == 0 ? double.MaxValue : Length);
+
+                if (Length == 0 || clamped < Length)
+                    hasCompleted = false;
+
+                endPending = false;
+                playStartPending = true;
+                lastReportedTime = double.MinValue;
+
+                if (renderer == null || pcm == null)
+                {
+                    pendingSeek = clamped;
+                    return;
+                }
+
+                renderer.SetPosition(clamped / 1000 * pcm.SampleRate);
+            }
+        }
+
+        protected override void UpdateState()
+        {
+            base.UpdateState();
+
+            bool completed = false;
+
+            lock (stateLock)
+            {
+                // The end has been heard.
+                if (endPending && unchecked(WebAudioEngine.ReadFrame - endWriteFrame) >= 0)
+                {
+                    endPending = false;
+                    isPlayed = false;
+                    hasCompleted = true;
+                    completed = true;
+
+                    if (renderer != null && pcm != null)
+                        renderer.SetPosition(Math.Min(renderer.Position, pcm.TotalFrames));
+                }
+            }
+
+            if (completed)
+                RaiseCompleted();
+
+            if (amplitudesRequested)
+                updateAmplitudes();
+        }
+
+        internal override void OnStateChanged()
+        {
+            base.OnStateChanged();
+
+            GainRamp.ComputeGains(AggregateVolume.Value, AggregateBalance.Value, out float left, out float right);
+
+            lock (stateLock)
+            {
+                gainLeft = left;
+                gainRight = right;
+                frequency = Math.Max(0, AggregateFrequency.Value);
+                tempo = Math.Max(tempo_minimum_supported, Math.Abs(AggregateTempo.Value));
+            }
+        }
+
+        public override ChannelAmplitudes CurrentAmplitudes
+        {
+            get
+            {
+                amplitudesRequested = true;
+                return currentAmplitudes;
+            }
+        }
+
+        private void updateAmplitudes()
+        {
+            var data = pcm;
+
+            if (data == null || !isPlayed)
+            {
+                currentAmplitudes = ChannelAmplitudes.Empty;
+                return;
+            }
+
+            amplitudeAnalyser ??= new AmplitudeAnalyser();
+
+            long frame = (long)(CurrentTime / 1000 * data.SampleRate);
+            currentAmplitudes = amplitudeAnalyser.Compute(data, frame);
+        }
+
+        #region Mixing
+
+        bool IWebAudioChannel.IsActive => !IsDisposed;
+
+        void IWebAudioChannel.MixInto(float[] buffer, float[] scratch, in WebMixContext context)
+        {
+            lock (stateLock)
+            {
+                if (IsDisposed || renderer == null || pcm == null || !isPlayed || endPending || frequency <= 0)
+                    return;
+
+                // If this track didn't contribute to the immediately preceding output (start / seek / stall / pause via zero frequency),
+                // begin a new continuous run so that latency compensation doesn't reach into audio this track didn't produce.
+                if (playStartPending || mixedWriteFrame != context.StartWriteFrame)
+                {
+                    playStartWriteFrame = context.StartWriteFrame;
+                    playStartPending = false;
+                }
+
+                long endFrame = pcm.TotalFrames;
+                int frames = context.Frames;
+                int done = 0;
+                int emptyRenders = 0;
+
+                while (done < frames)
+                {
+                    int rendered = renderer.Render(scratch.AsSpan(done * 2), frames - done, context.SampleRate, frequency, tempo, endFrame, out bool stalled);
+                    done += rendered;
+
+                    if (done >= frames || stalled)
+                        break;
+
+                    // The end of the track has been reached.
+                    if (Looping && endFrame > 0)
+                    {
+                        // guard against degenerate cases producing no audio at all.
+                        if (rendered == 0 && ++emptyRenders > 1)
+                            break;
+
+                        // Match TrackBass: loop back to the restart point.
+                        renderer.SetPosition(Math.Clamp(RestartPoint / 1000 * pcm.SampleRate, 0, endFrame - 1));
+                        playStartWriteFrame = unchecked(context.StartWriteFrame + done);
+                        lastReportedTime = double.MinValue;
+                        continue;
+                    }
+
+                    endPending = true;
+                    endWriteFrame = unchecked(context.StartWriteFrame + done);
+                    break;
+                }
+
+                gainRamp.MixInto(scratch, buffer, done, gainLeft, gainRight);
+
+                mixedTime = Math.Min(renderer.Position, endFrame) * 1000 / pcm.SampleRate;
+                mixedWriteFrame = unchecked(context.StartWriteFrame + done);
+                mixedMillisecondsPerFrame = 1000.0 * frequency * tempo / context.SampleRate;
+            }
+        }
+
+        private WebAudioMixer? webMixer => Mixer as WebAudioMixer;
+
+        #endregion
+
+        ~TrackWeb()
+        {
+            Dispose(false);
+        }
+
+        protected override void Dispose(bool disposing)
+        {
+            if (IsDisposed)
+                return;
+
+            decodeCancellation.Cancel();
+
+            lock (stateLock)
+            {
+                isPlayed = false;
+                endPending = false;
+            }
+
+            webMixer?.StreamFree(this);
+
+            base.Dispose(disposing);
+
+            lock (stateLock)
+            {
+                renderer = null;
+                pcm = null;
+            }
+        }
+    }
+}
+
+#endif
