@@ -0,0 +1,65 @@
+// Copyright (c) ppy Pty Ltd <contact@ppy.sh>. Licensed under the MIT Licence.
+// See the LICENCE file in the repository root for full licence text.
+
+#if OSU_WEB
+
+using System;
+using osu.Framework.Audio.Track;
+
+namespace osu.Framework.Audio.Web
+{
+    /// <summary>
+    /// Computes <see cref="ChannelAmplitudes"/> (peak levels and a 512-sample FFT magnitude spectrum, like BASS's <c>BASS_DATA_FFT512</c>) from <see cref="PcmData"/>.
+    /// </summary>
+    internal sealed class AmplitudeAnalyser
+    {
+        private const int fft_size = ChannelAmplitudes.AMPLITUDES_SIZE * 2;
+
+        /// <summary>
+        /// The duration over which peak levels are measured, in seconds (matches <see cref="BassAmplitudeProcessor"/>).
+        /// </summary>
+        private const double level_window_seconds = 1 / 60.0;
+
+        private readonly Fft fft = new Fft(fft_size);
+        private readonly float[] samples = new float[fft_size];
+        private readonly float[] amplitudes = new float[ChannelAmplitudes.AMPLITUDES_SIZE];
+
+        /// <summary>
+        /// Computes amplitudes for the audio starting at <paramref name="frame"/>.
+        /// </summary>
+        /// <param name="data">The source data.</param>
+        /// <param name="frame">The source frame corresponding to the audible position.</param>
+        public ChannelAmplitudes Compute(PcmData data, long frame)
+        {
+            long available = data.DecodedFrames;
+
+            if (frame < 0 || frame >= available)
+                return ChannelAmplitudes.Empty;
+
+            int levelFrames = Math.Max(1, (int)(data.SampleRate * level_window_seconds));
+
+            float peakLeft = 0;
+            float peakRight = 0;
+
+            for (int i = 0; i < levelFrames; i++)
+            {
+                data.GetFrame(frame + i, available, out float l, out float r);
+                peakLeft = Math.Max(peakLeft, Math.Abs(l));
+                peakRight = Math.Max(peakRight, Math.Abs(r));
+            }
+
+            for (int i = 0; i < fft_size; i++)
+            {
+                data.GetFrame(frame + i, available, out float l, out float r);
+                samples[i] = (l + r) * 0.5f;
+            }
+
+            // Like BassAmplitudeProcessor, the frequency data array is reused between computations.
+            fft.ComputeMagnitudes(samples, amplitudes);
+
+            return new ChannelAmplitudes(Math.Min(1, peakLeft), Math.Min(1, peakRight), amplitudes);
+        }
+    }
+}
+
+#endif
diff --git a/osu.Framework/Audio/Web/AudioDecoder.cs b/osu.Framework/Audio/Web/AudioDecoder.cs
new file mode 100644
index 000000000..dfd5ef2e6
--- /dev/null
+++ b/osu.Framework/Audio/Web/AudioDecoder.cs
@@ -0,0 +1,373 @@
+// Copyright (c) ppy Pty Ltd <contact@ppy.sh>. Licensed under the MIT Licence.
+// See the LICENCE file in the repository root for full licence text.
+
+#if OSU_WEB
+
+using System;
+using System.Buffers.Binary;
+using System.IO;
+using System.Threading;
+using NLayer;
+using NVorbis;
+
+namespace osu.Framework.Audio.Web
+{
+    /// <summary>
+    /// A fully managed audio decoder supporting WAV (PCM / IEEE float / MP3-in-WAV), Ogg Vorbis and MP3.
+    /// </summary>
+    internal abstract class AudioDecoder : IDisposable
+    {
+        /// <summary>
+        /// The number of frames decoded per iteration of <see cref="DecodeInto"/>.
+        /// </summary>
+        private const int decode_chunk_frames = 4096;
+
+        /// <summary>
+        /// The native sample rate of the audio, in Hz.
+        /// </summary>
+        public int SampleRate { get; protected init; }
+
+        /// <summary>
+        /// The number of channels in the source audio (may be more than 2).
+        /// </summary>
+        public int Channels { get; protected init; }
+
+        /// <summary>
+        /// The estimated total number of frames, or 0 if unknown.
+        /// </summary>
+        public long EstimatedFrames { get; protected init; }
+
+        /// <summary>
+        /// The bitrate of the source audio in kbps, or 0 if unknown.
+        /// </summary>
+        public int Bitrate { get; protected init; }
+
+        /// <summary>
+        /// Reads interleaved float samples (with <see cref="Channels"/> channels).
+        /// </summary>
+        /// <param name="buffer">The destination buffer.</param>
+        /// <param name="maxFrames">The maximum number of frames to read.</param>
+        /// <returns>The number of frames read. 0 indicates the end of the stream.</returns>
+        public abstract int Read(float[] buffer, int maxFrames);
+
+        public virtual void Dispose()
+        {
+        }
+
+        /// <summary>
+        /// Creates a decoder for the given encoded audio data.
+        /// </summary>
+        /// <exception cref="NotSupportedException">If the data format is not supported.</exception>
+        public static AudioDecoder Create(byte[] data)
+        {
+            ArgumentNullException.ThrowIfNull(data);
+
+            if (data.Length < 4)
+                throw new NotSupportedException("Audio data is too short.");
+
+            ReadOnlySpan<byte> span = data;
+
+            if (span.Length >= 12 && span[..4].SequenceEqual("RIFF"u8) && span.Slice(8, 4).SequenceEqual("WAVE"u8))
+                return WavDecoder.Parse(data);
+
+            if (span[..4].SequenceEqual("OggS"u8))
+                return new VorbisDecoder(new MemoryStream(data, false));
+
+            if (span[..4].SequenceEqual("fLaC"u8))
+                throw new NotSupportedException("FLAC audio is not supported.");
+
+            return new Mp3Decoder(new MemoryStream(data, false), data.Length);
+        }
+
+        /// <summary>
+        /// Creates a <see cref="PcmData"/> container suitable for receiving the output of this decoder.
+        /// </summary>
+        public PcmData CreatePcmData() => new PcmData(SampleRate, Math.Min(2, Channels), EstimatedFrames);
+
+        /// <summary>
+        /// Decodes the remainder of this decoder's stream into <paramref name="pcm"/> (downmixing to at most two channels) and marks it complete.
+        /// Decoding errors part-way through the stream are treated as the end of the stream.
+        /// </summary>
+        /// <returns>Whether decoding finished without errors.</returns>
+        public bool DecodeInto(PcmData pcm, CancellationToken cancellationToken = default)
+        {
+            int sourceChannels = Channels;
+            int outputChannels = pcm.Channels;
+
+            float[] buffer = new float[decode_chunk_frames * sourceChannels];
+            float[] converted = sourceChannels == outputChannels ? buffer : new float[decode_chunk_frames * outputChannels];
+
+            bool success = true;
+
+            try
+            {
+                while (!cancellationToken.IsCancellationRequested)
+                {
+                    int frames = Read(buffer, decode_chunk_frames);
+
+                    if (frames <= 0)
+                        break;
+
+                    if (converted != buffer)
+                    {
+                        // keep the first two channels (front left / front right in all common layouts).
+                        for (int i = 0; i < frames; i++)
+                        {
+                            for (int c = 0; c < outputChannels; c++)
+                                converted[i * outputChannels + c] = buffer[i * sourceChannels + c];
+                        }
+                    }
+
+                    pcm.Append(converted, frames);
+                }
+            }
+            catch (Exception)
+            {
+                // Corrupt data part-way through the stream. Keep whatever was decoded.
+                success = false;
+            }
+            finally
+            {
+                pcm.Complete();
+            }
+
+            return success;
+        }
+
+        /// <summary>
+        /// Fully decodes the given data. Returns <c>null</c> if the data could not be decoded.
+        /// </summary>
+        public static PcmData? DecodeAll(byte[] data, out string? error)
+        {
+            error = null;
+
+            try
+            {
+                using (var decoder = Create(data))
+                {
+                    var pcm = decoder.CreatePcmData();
+                    if (!decoder.DecodeInto(pcm))
+                        error = "stream was truncated or corrupt";
+                    return pcm;
+                }
+            }
+            catch (Exception e)
+            {
+                error = e.Message;
+                return null;
+            }
+        }
+
+        /// <summary>
+        /// Reads a whole stream into a byte array.
+        /// </summary>
+        public static byte[] ReadAllBytes(Stream stream)
+        {
+            if (stream is MemoryStream ms && ms.TryGetBuffer(out var segment) && segment.Offset == 0 && ms.Position == 0 && segment.Count == segment.Array!.Length)
+                return segment.Array;
+
+            using (var copy = new MemoryStream(stream.CanSeek ? (int)Math.Max(0, stream.Length - stream.Position) : 0))
+            {
+                stream.CopyTo(copy);
+                return copy.ToArray();
+            }
+        }
+
+        private sealed class Mp3Decoder : AudioDecoder
+        {
+            private readonly MpegFile file;
+
+            public Mp3Decoder(Stream stream, long byteLength)
+            {
+                file = new MpegFile(stream);
+
+                SampleRate = file.SampleRate;
+                Channels = Math.Max(1, file.Channels);
+
+                // Length is the total number of (float) sample bytes across all channels.
+                // Retrieving it scans the frame headers of the whole stream, which is fast relative to decoding.
+                long length = file.Length;
+                EstimatedFrames = length > 0 ? length / (sizeof(float) * Channels) : 0;
+
+                if (EstimatedFrames > 0 && SampleRate > 0)
+                    Bitrate = (int)Math.Round(byteLength * 8 / ((double)EstimatedFrames / SampleRate) / 1000);
+
+                file.Position = 0;
+            }
+
+            public override int Read(float[] buffer, int maxFrames) => file.ReadSamples(buffer, 0, maxFrames * Channels) / Channels;
+
+            public override void Dispose() => file.Dispose();
+        }
+
+        private sealed class VorbisDecoder : AudioDecoder
+        {
+            private readonly VorbisReader reader;
+
+            public VorbisDecoder(Stream stream)
+            {
+                reader = new VorbisReader(stream, true);
+
+                SampleRate = reader.SampleRate;
+                Channels = Math.Max(1, reader.Channels);
+                EstimatedFrames = Math.Max(0, reader.TotalSamples);
+                Bitrate = Math.Max(0, reader.NominalBitrate / 1000);
+            }
+
+            public override int Read(float[] buffer, int maxFrames) => reader.ReadSamples(buffer, 0, maxFrames * Channels) / Channels;
+
+            public override void Dispose() => reader.Dispose();
+        }
+
+        private sealed class WavDecoder : AudioDecoder
+        {
+            private const int format_pcm = 1;
+            private const int format_float = 3;
+            private const int format_mp3 = 0x55;
+            private const int format_extensible = 0xFFFE;
+
+            private readonly byte[] data;
+            private readonly int format;
+            private readonly int bitsPerSample;
+            private readonly int blockAlign;
+            private readonly int dataEnd;
+            private int position;
+
+            private WavDecoder(byte[] data, int format, int channels, int sampleRate, int bitsPerSample, int blockAlign, int dataStart, int dataLength)
+            {
+                this.data = data;
+                this.format = format;
+                this.bitsPerSample = bitsPerSample;
+                this.blockAlign = blockAlign;
+
+                Channels = channels;
+                SampleRate = sampleRate;
+                position = dataStart;
+                dataEnd = dataStart + dataLength;
+                EstimatedFrames = dataLength / blockAlign;
+                Bitrate = (int)((long)sampleRate * channels * bitsPerSample / 1000);
+            }
+
+            public static AudioDecoder Parse(byte[] data)
+            {
+                ReadOnlySpan<byte> span = data;
+
+                int pos = 12;
+
+                int format = -1;
+                int channels = 0;
+                int sampleRate = 0;
+                int blockAlign = 0;
+                int bitsPerSample = 0;
+
+                while (pos + 8 <= span.Length)
+                {
+                    var id = span.Slice(pos, 4);
+                    int size = (int)Math.Min(BinaryPrimitives.ReadUInt32LittleEndian(span.Slice(pos + 4, 4)), int.MaxValue);
+                    int body = pos + 8;
+
+                    if (id.SequenceEqual("fmt "u8))
+                    {
+                        if (size < 16 || body + 16 > span.Length)
+                            throw new NotSupportedException("Invalid WAV format chunk.");
+
+                        format = BinaryPrimitives.ReadUInt16LittleEndian(span.Slice(body, 2));
+                        channels = BinaryPrimitives.ReadUInt16LittleEndian(span.Slice(body + 2, 2));
+                        sampleRate = (int)BinaryPrimitives.ReadUInt32LittleEndian(span.Slice(body + 4, 4));
+                        blockAlign = BinaryPrimitives.ReadUInt16LittleEndian(span.Slice(body + 12, 2));
+                        bitsPerSample = BinaryPrimitives.ReadUInt16LittleEndian(span.Slice(body + 14, 2));
+
+                        // WAVE_FORMAT_EXTENSIBLE: the actual format is the first two bytes of the sub-format GUID.
+                        if (format == format_extensible && size >= 40 && body + 26 <= span.Length)
+                            format = BinaryPrimitives.ReadUInt16LittleEndian(span.Slice(body + 24, 2));
+                    }
+                    else if (id.SequenceEqual("data"u8))
+                    {
+                        if (format < 0)
+                            throw new NotSupportedException("WAV data chunk found before format chunk.");
+
+                        // Streamed WAVs may declare a zero / oversized data chunk length, so clamp to the available data.
+                        int available = span.Length - body;
+                        int length = size == 0 || size > available ? available : size;
+
+                        if (format == format_mp3)
+                            return new Mp3Decoder(new MemoryStream(data, body, length, false), length);
+
+                        if (channels <= 0 || sampleRate <= 0)
+                            throw new NotSupportedException("Invalid WAV format.");
+
+                        bool supported = (format == format_pcm && bitsPerSample is 8 or 16 or 24 or 32)
+                                         || (format == format_float && bitsPerSample is 32 or 64);
+
+                        if (!supported)
+                            throw new NotSupportedException($"Unsupported WAV format (format {format}, {bitsPerSample} bits).");
+
+                        int minimumAlign = channels * (bitsPerSample / 8);
+                        if (blockAlign < minimumAlign)
+                            blockAlign = minimumAlign;
+
+                        return new WavDecoder(data, format, channels, sampleRate, bitsPerSample, blockAlign, body, length - length % blockAlign);
+                    }
+
+                    // chunks are padded to an even size.
+                    long next = (long)body + size + (size & 1);
+                    if (next > span.Length)
+                        break;
+
+                    pos = (int)next;
+                }
+
+                throw new NotSupportedException("WAV file contains no data chunk.");
+            }
+
+            public override int Read(float[] buffer, int maxFrames)
+            {
+                int frames = Math.Min(maxFrames, (dataEnd - position) / blockAlign);
+                if (frames <= 0)
+                    return 0;
+
+                ReadOnlySpan<byte> span = data;
+                int bytesPerSample = bitsPerSample / 8;
+                int outIndex = 0;
+
+                for (int f = 0; f < frames; f++)
+                {
+                    int frameStart = position + f * blockAlign;
+
+                    for (int c = 0; c < Channels; c++)
+                        buffer[outIndex++] = readSample(span.Slice(frameStart + c * bytesPerSample, bytesPerSample));
+                }
+
+                position += frames * blockAlign;
+                return frames;
+            }
+
+            private float readSample(ReadOnlySpan<byte> s)
+            {
+                if (format == format_float)
+                {
+                    return bitsPerSample == 32
+                        ? BinaryPrimitives.ReadSingleLittleEndian(s)
+                        : (float)BinaryPrimitives.ReadDoubleLittleEndian(s);
+                }
+
+                switch (bitsPerSample)
+                {
+                    case 8:
+                        return (s[0] - 128) / 128f;
+
+                    case 16:
+                        return BinaryPrimitives.ReadInt16LittleEndian(s) / 32768f;
+
+                    case 24:
+                        return ((s[0] << 8) | (s[1] << 16) | (s[2] << 24)) / 2147483648f;
+
+                    default:
+                        return BinaryPrimitives.ReadInt32LittleEndian(s) / 2147483648f;
+                }
+            }
+        }
+    }
+}
+
+#endif
diff --git a/osu.Framework/Audio/Web/BiquadFilter.cs b/osu.Framework/Audio/Web/BiquadFilter.cs
new file mode 100644
index 000000000..adf8c1bff
--- /dev/null
+++ b/osu.Framework/Audio/Web/BiquadFilter.cs
@@ -0,0 +1,206 @@
+// Copyright (c) ppy Pty Ltd <contact@ppy.sh>. Licensed under the MIT Licence.
+// See the LICENCE file in the repository root for full licence text.
+
+#if OSU_WEB
+
+using System;
+using ManagedBass.Fx;
+
+namespace osu.Framework.Audio.Web
+{
+    /// <summary>
+    /// A stereo biquad filter matching the behaviour of BASS_FX's BQF effect (RBJ audio EQ cookbook formulae).
+    /// </summary>
+    internal sealed class BiquadFilter
+    {
+        private double b0, b1, b2, a1, a2;
+
+        // transposed direct form II state, per channel.
+        private double z1L, z2L, z1R, z2R;
+
+        private BQFType type;
+        private float center;
+        private float gain;
+        private float bandwidth;
+        private float q;
+        private float s;
+
+        private int sampleRate;
+        private bool dirty = true;
+
+        /// <summary>
+        /// Copies parameters from a <see cref="BQFParameters"/>. Filter state is preserved to avoid discontinuities.
+        /// </summary>
+        public void SetParameters(BQFParameters parameters)
+        {
+            type = parameters.lFilter;
+            center = parameters.fCenter;
+            gain = parameters.fGain;
+            bandwidth = parameters.fBandwidth;
+            q = parameters.fQ;
+            s = parameters.fS;
+            dirty = true;
+        }
+
+        /// <summary>
+        /// Processes interleaved stereo samples in-place.
+        /// </summary>
+        public void Process(Span<float> buffer, int frames, int rate)
+        {
+            if (dirty || rate != sampleRate)
+            {
+                sampleRate = rate;
+                computeCoefficients();
+                dirty = false;
+            }
+
+            for (int i = 0; i < frames; i++)
+            {
+                double l = buffer[i * 2];
+                double r = buffer[i * 2 + 1];
+
+                double outL = b0 * l + z1L;
+                z1L = b1 * l - a1 * outL + z2L;
+                z2L = b2 * l - a2 * outL;
+
+                double outR = b0 * r + z1R;
+                z1R = b1 * r - a1 * outR + z2R;
+                z2R = b2 * r - a2 * outR;
+
+                buffer[i * 2] = (float)outL;
+                buffer[i * 2 + 1] = (float)outR;
+            }
+
+            // flush denormals / recover from instability.
+            if (!double.IsFinite(z1L) || !double.IsFinite(z1R) || !double.IsFinite(z2L) || !double.IsFinite(z2R))
+                z1L = z2L = z1R = z2R = 0;
+        }
+
+        private void computeCoefficients()
+        {
+            double nyquist = sampleRate / 2.0;
+            double f0 = Math.Clamp(center, 1, nyquist * 0.999);
+            double w0 = 2 * Math.PI * f0 / sampleRate;
+            double cosW0 = Math.Cos(w0);
+            double sinW0 = Math.Sin(w0);
+            double a = Math.Pow(10, gain / 40.0);
+
+            double alpha;
+
+            if (bandwidth > 0)
+                alpha = sinW0 * Math.Sinh(Math.Log(2) / 2 * bandwidth * w0 / sinW0);
+            else if ((type == BQFType.LowShelf || type == BQFType.HighShelf) && s > 0)
+                alpha = sinW0 / 2 * Math.Sqrt((a + 1 / a) * (1 / s - 1) + 2);
+            else
+                alpha = sinW0 / (2 * (q > 0 ? q : Math.Sqrt(0.5)));
+
+            double nb0, nb1, nb2, na0, na1, na2;
+
+            switch (type)
+            {
+                case BQFType.LowPass:
+                    nb0 = (1 - cosW0) / 2;
+                    nb1 = 1 - cosW0;
+                    nb2 = (1 - cosW0) / 2;
+                    na0 = 1 + alpha;
+                    na1 = -2 * cosW0;
+                    na2 = 1 - alpha;
+                    break;
+
+                case BQFType.HighPass:
+                    nb0 = (1 + cosW0) / 2;
+                    nb1 = -(1 + cosW0);
+                    nb2 = (1 + cosW0) / 2;
+                    na0 = 1 + alpha;
+                    na1 = -2 * cosW0;
+                    na2 = 1 - alpha;
+                    break;
+
+                case BQFType.BandPass:
+                    // constant 0 dB peak gain
+                    nb0 = alpha;
+                    nb1 = 0;
+                    nb2 = -alpha;
+                    na0 = 1 + alpha;
+                    na1 = -2 * cosW0;
+                    na2 = 1 - alpha;
+                    break;
+
+                case BQFType.BandPassQ:
+                    // constant skirt gain, peak gain = Q
+                    nb0 = sinW0 / 2;
+                    nb1 = 0;
+                    nb2 = -sinW0 / 2;
+                    na0 = 1 + alpha;
+                    na1 = -2 * cosW0;
+                    na2 = 1 - alpha;
+                    break;
+
+                case BQFType.Notch:
+                    nb0 = 1;
+                    nb1 = -2 * cosW0;
+                    nb2 = 1;
+                    na0 = 1 + alpha;
+                    na1 = -2 * cosW0;
+                    na2 = 1 - alpha;
+                    break;
+
+                case BQFType.AllPass:
+                    nb0 = 1 - alpha;
+                    nb1 = -2 * cosW0;
+                    nb2 = 1 + alpha;
+                    na0 = 1 + alpha;
+                    na1 = -2 * cosW0;
+                    na2 = 1 - alpha;
+                    break;
+
+                case BQFType.PeakingEQ:
+                    nb0 = 1 + alpha * a;
+                    nb1 = -2 * cosW0;
+                    nb2 = 1 - alpha * a;
+                    na0 = 1 + alpha / a;
+                    na1 = -2 * cosW0;
+                    na2 = 1 - alpha / a;
+                    break;
+
+                case BQFType.LowShelf:
+                {
+                    double sqrtA2Alpha = 2 * Math.Sqrt(a) * alpha;
+                    nb0 = a * ((a + 1) - (a - 1) * cosW0 + sqrtA2Alpha);
+                    nb1 = 2 * a * ((a - 1) - (a + 1) * cosW0);
+                    nb2 = a * ((a + 1) - (a - 1) * cosW0 - sqrtA2Alpha);
+                    na0 = (a + 1) + (a - 1) * cosW0 + sqrtA2Alpha;
+                    na1 = -2 * ((a - 1) + (a + 1) * cosW0);
+                    na2 = (a + 1) + (a - 1) * cosW0 - sqrtA2Alpha;
+                    break;
+                }
+
+                case BQFType.HighShelf:
+                {
+                    double sqrtA2Alpha = 2 * Math.Sqrt(a) * alpha;
+                    nb0 = a * ((a + 1) + (a - 1) * cosW0 + sqrtA2Alpha);
+                    nb1 = -2 * a * ((a - 1) + (a + 1) * cosW0);
+                    nb2 = a * ((a + 1) + (a - 1) * cosW0 - sqrtA2Alpha);
+                    na0 = (a + 1) - (a - 1) * cosW0 + sqrtA2Alpha;
+                    na1 = 2 * ((a - 1) - (a + 1) * cosW0);
+                    na2 = (a + 1) - (a - 1) * cosW0 - sqrtA2Alpha;
+                    break;
+                }
+
+                default:
+                    // unknown type: pass-through.
+                    nb0 = na0 = 1;
+                    nb1 = nb2 = na1 = na2 = 0;
+                    break;
+            }
+
+            b0 = nb0 / na0;
+            b1 = nb1 / na0;
+            b2 = nb2 / na0;
+            a1 = na1 / na0;
+            a2 = na2 / na0;
+        }
+    }
+}
+
+#endif
diff --git a/osu.Framework/Audio/Web/Fft.cs b/osu.Framework/Audio/Web/Fft.cs
new file mode 100644
index 000000000..c20212334
--- /dev/null
+++ b/osu.Framework/Audio/Web/Fft.cs
@@ -0,0 +1,109 @@
+// Copyright (c) ppy Pty Ltd <contact@ppy.sh>. Licensed under the MIT Licence.
+// See the LICENCE file in the repository root for full licence text.
+
+#if OSU_WEB
+
+using System;
+using System.Numerics;
+
+namespace osu.Framework.Audio.Web
+{
+    /// <summary>
+    /// A Hann-windowed magnitude spectrum calculator (radix-2 FFT), producing values comparable to BASS's <c>BASS_DATA_FFT*</c> data.
+    /// </summary>
+    internal sealed class Fft
+    {
+        /// <summary>
+        /// The number of input samples.
+        /// </summary>
+        public readonly int Size;
+
+        private readonly float[] window;
+        private readonly int[] bitReversal;
+        private readonly double[] cosTable;
+        private readonly double[] sinTable;
+
+        private readonly double[] real;
+        private readonly double[] imaginary;
+
+        public Fft(int size)
+        {
+            if (size < 2 || !BitOperations.IsPow2(size))
+                throw new ArgumentException("FFT size must be a power of two.", nameof(size));
+
+            Size = size;
+
+            real = new double[size];
+            imaginary = new double[size];
+
+            window = new float[size];
+            for (int i = 0; i < size; i++)
+                window[i] = (float)(0.5 - 0.5 * Math.Cos(2 * Math.PI * i / (size - 1)));
+
+            int bits = BitOperations.Log2((uint)size);
+            bitReversal = new int[size];
+
+            for (int i = 0; i < size; i++)
+            {
+                int reversed = 0;
+                for (int b = 0; b < bits; b++)
+                    reversed |= ((i >> b) & 1) << (bits - 1 - b);
+                bitReversal[i] = reversed;
+            }
+
+            cosTable = new double[size / 2];
+            sinTable = new double[size / 2];
+
+            for (int i = 0; i < size / 2; i++)
+            {
+                double angle = -2 * Math.PI * i / size;
+                cosTable[i] = Math.Cos(angle);
+                sinTable[i] = Math.Sin(angle);
+            }
+        }
+
+        /// <summary>
+        /// Computes the magnitude spectrum of <paramref name="input"/> (<see cref="Size"/> samples) into <paramref name="output"/> (<see cref="Size"/> / 2 bins, clamped to 0..1).
+        /// </summary>
+        public void ComputeMagnitudes(ReadOnlySpan<float> input, Span<float> output)
+        {
+            for (int i = 0; i < Size; i++)
+                real[bitReversal[i]] = input[i] * window[i];
+
+            Array.Clear(imaginary);
+
+            for (int size = 2; size <= Size; size <<= 1)
+            {
+                int half = size >> 1;
+                int tableStep = Size / size;
+
+                for (int start = 0; start < Size; start += size)
+                {
+                    for (int k = 0; k < half; k++)
+                    {
+                        double wr = cosTable[k * tableStep];
+                        double wi = sinTable[k * tableStep];
+
+                        int even = start + k;
+                        int odd = even + half;
+
+                        double tr = real[odd] * wr - imaginary[odd] * wi;
+                        double ti = real[odd] * wi + imaginary[odd] * wr;
+
+                        real[odd] = real[even] - tr;
+                        imaginary[odd] = imaginary[even] - ti;
+                        real[even] += tr;
+                        imaginary[even] += ti;
+                    }
+                }
+            }
+
+            double scale = 2.0 / Size;
+
+            for (int i = 0; i < Size / 2; i++)
+                output[i] = (float)Math.Min(1, Math.Sqrt(real[i] * real[i] + imaginary[i] * imaginary[i]) * scale);
+        }
+    }
+}
+
+#endif
diff --git a/osu.Framework/Audio/Web/GainRamp.cs b/osu.Framework/Audio/Web/GainRamp.cs
new file mode 100644
index 000000000..bc94438cf
--- /dev/null
+++ b/osu.Framework/Audio/Web/GainRamp.cs
@@ -0,0 +1,83 @@
+// Copyright (c) ppy Pty Ltd <contact@ppy.sh>. Licensed under the MIT Licence.
+// See the LICENCE file in the repository root for full licence text.
+
+#if OSU_WEB
+
+using System;
+
+namespace osu.Framework.Audio.Web
+{
+    /// <summary>
+    /// Applies per-channel volume and balance, smoothly ramping between gain changes to avoid audible clicks.
+    /// </summary>
+    internal struct GainRamp
+    {
+        private float currentLeft;
+        private float currentRight;
+        private bool initialised;
+
+        /// <summary>
+        /// Computes left/right gains matching BASS's volume and pan attributes.
+        /// </summary>
+        public static void ComputeGains(double volume, double balance, out float left, out float right)
+        {
+            float v = (float)Math.Max(0, volume);
+            float b = (float)Math.Clamp(balance, -1, 1);
+
+            left = v * (b > 0 ? 1 - b : 1);
+            right = v * (b < 0 ? 1 + b : 1);
+        }
+
+        /// <summary>
+        /// Resets the ramp such that the next call to <see cref="MixInto"/> starts at the target gain immediately.
+        /// </summary>
+        public void Reset() => initialised = false;
+
+        /// <summary>
+        /// Adds <paramref name="source"/> (interleaved stereo) into <paramref name="destination"/> with the given target gains.
+        /// </summary>
+        public void MixInto(ReadOnlySpan<float> source, Span<float> destination, int frames, float targetLeft, float targetRight)
+        {
+            if (!initialised)
+            {
+                currentLeft = targetLeft;
+                currentRight = targetRight;
+                initialised = true;
+            }
+
+            if (frames <= 0)
+                return;
+
+            float startLeft = currentLeft;
+            float startRight = currentRight;
+
+            if (startLeft == targetLeft && startRight == targetRight)
+            {
+                if (targetLeft == 0 && targetRight == 0)
+                    return;
+
+                for (int i = 0; i < frames; i++)
+                {
+                    destination[i * 2] += source[i * 2] * targetLeft;
+                    destination[i * 2 + 1] += source[i * 2 + 1] * targetRight;
+                }
+
+                return;
+            }
+
+            float stepLeft = (targetLeft - startLeft) / frames;
+            float stepRight = (targetRight - startRight) / frames;
+
+            for (int i = 0; i < frames; i++)
+            {
+                destination[i * 2] += source[i * 2] * (startLeft + stepLeft * (i + 1));
+                destination[i * 2 + 1] += source[i * 2 + 1] * (startRight + stepRight * (i + 1));
+            }
+
+            currentLeft = targetLeft;
+            currentRight = targetRight;
+        }
+    }
+}
+
+#endif
diff --git a/osu.Framework/Audio/Web/PcmData.cs b/osu.Framework/Audio/Web/PcmData.cs
new file mode 100644
index 000000000..895a6c525
--- /dev/null
+++ b/osu.Framework/Audio/Web/PcmData.cs
@@ -0,0 +1,198 @@
+// Copyright (c) ppy Pty Ltd <contact@ppy.sh>. Licensed under the MIT Licence.
+// See the LICENCE file in the repository root for full licence text.
+
+#if OSU_WEB
+
+using System;
+using System.Runtime.CompilerServices;
+using System.Threading;
+
+namespace osu.Framework.Audio.Web
+{
+    /// <summary>
+    /// Decoded PCM audio data, stored as interleaved 16-bit integers (mono or stereo) at the source's native sample rate.
+    /// </summary>
+    /// <remarks>
+    /// Data is stored in fixed-size blocks so that it can be appended to (by a background decoder) while being concurrently read
+    /// (by the mixer thread) without ever having to move existing data.
+    /// A single writer may call <see cref="Append"/> while any number of readers read frames below <see cref="DecodedFrames"/>.
+    /// </remarks>
+    internal sealed class PcmData
+    {
+        private const int block_shift = 16;
+        private const int block_frames = 1 << block_shift;
+        private const int block_mask = block_frames - 1;
+
+        private const float short_to_float = 1f / 32768f;
+
+        /// <summary>
+        /// The sample rate of the data, in Hz.
+        /// </summary>
+        public readonly int SampleRate;
+
+        /// <summary>
+        /// The number of stored channels (1 or 2).
+        /// </summary>
+        public readonly int Channels;
+
+        private short[][] blocks = Array.Empty<short[]>();
+
+        private long decodedFrames;
+        private long estimatedTotalFrames;
+        private volatile bool isComplete;
+
+        public PcmData(int sampleRate, int channels, long estimatedTotalFrames = 0)
+        {
+            ArgumentOutOfRangeException.ThrowIfNegativeOrZero(sampleRate);
+
+            SampleRate = sampleRate;
+            Channels = Math.Clamp(channels, 1, 2);
+            this.estimatedTotalFrames = Math.Max(0, estimatedTotalFrames);
+        }
+
+        /// <summary>
+        /// The number of frames which have been decoded and are available for reading.
+        /// </summary>
+        public long DecodedFrames => Interlocked.Read(ref decodedFrames);
+
+        /// <summary>
+        /// Whether decoding has finished. Once true, <see cref="DecodedFrames"/> is the final length.
+        /// </summary>
+        public bool IsComplete => isComplete;
+
+        /// <summary>
+        /// The total length in frames. This is an estimate until <see cref="IsComplete"/> is true.
+        /// </summary>
+        public long TotalFrames => isComplete ? DecodedFrames : Math.Max(Interlocked.Read(ref estimatedTotalFrames), DecodedFrames);
+
+        /// <summary>
+        /// The total length in milliseconds. This is an estimate until <see cref="IsComplete"/> is true.
+        /// </summary>
+        public double LengthMilliseconds => TotalFrames * 1000.0 / SampleRate;
+
+        /// <summary>
+        /// The approximate amount of memory used by the sample data, in bytes.
+        /// </summary>
+        public long MemoryUsage => (long)Volatile.Read(ref blocks).Length * block_frames * Channels * sizeof(short);
+
+        /// <summary>
+        /// Appends interleaved float frames. Must only be called by a single writer.
+        /// </summary>
+        /// <param name="interleaved">Interleaved float samples with <see cref="Channels"/> channels.</param>
+        /// <param name="frames">The number of frames to append.</param>
+        public void Append(ReadOnlySpan<float> interleaved, int frames)
+        {
+            if (isComplete)
+                throw new InvalidOperationException("Cannot append to completed PCM data.");
+
+            long start = decodedFrames;
+            int channels = Channels;
+
+            for (int i = 0; i < frames;)
+            {
+                long frame = start + i;
+                int blockIndex = (int)(frame >> block_shift);
+                int offset = (int)(frame & block_mask);
+
+                short[] block = getOrCreateBlock(blockIndex);
+
+                int count = Math.Min(frames - i, block_frames - offset);
+                var source = interleaved.Slice(i * channels, count * channels);
+                var dest = block.AsSpan(offset * channels, count * channels);
+
+                for (int s = 0; s < source.Length; s++)
+                    dest[s] = floatToShort(source[s]);
+
+                i += count;
+            }
+
+            // publish only after the data has been written.
+            Interlocked.Exchange(ref decodedFrames, start + frames);
+        }
+
+        /// <summary>
+        /// Marks decoding as complete. <see cref="TotalFrames"/> becomes exact.
+        /// </summary>
+        public void Complete()
+        {
+            Interlocked.Exchange(ref estimatedTotalFrames, DecodedFrames);
+            isComplete = true;
+        }
+
+        /// <summary>
+        /// Retrieves a single stereo frame. Frames outside the decoded range are silent.
+        /// </summary>
+        [MethodImpl(MethodImplOptions.AggressiveInlining)]
+        public void GetFrame(long frame, long available, out float left, out float right)
+        {
+            if (frame < 0 || frame >= available)
+            {
+                left = right = 0;
+                return;
+            }
+
+            short[] block = Volatile.Read(ref blocks)[frame >> block_shift];
+            int offset = (int)(frame & block_mask);
+
+            if (Channels == 2)
+            {
+                left = block[offset * 2] * short_to_float;
+                right = block[offset * 2 + 1] * short_to_float;
+            }
+            else
+                left = right = block[offset] * short_to_float;
+        }
+
+        /// <summary>
+        /// Reads frames starting at <paramref name="position"/> (in fractional source frames), advancing by <paramref name="step"/> source frames per output frame,
+        /// using linear interpolation. Writes interleaved stereo into <paramref name="destination"/>.
+        /// </summary>
+        public void ReadResampled(double position, double step, Span<float> destination, int frames, long available)
+        {
+            for (int i = 0; i < frames; i++)
+            {
+                double p = position + i * step;
+                double floor = Math.Floor(p);
+                long index = (long)floor;
+                float frac = (float)(p - floor);
+
+                GetFrame(index, available, out float l0, out float r0);
+
+                if (frac > 0)
+                {
+                    GetFrame(index + 1, available, out float l1, out float r1);
+                    l0 += (l1 - l0) * frac;
+                    r0 += (r1 - r0) * frac;
+                }
+
+                destination[i * 2] = l0;
+                destination[i * 2 + 1] = r0;
+            }
+        }
+
+        private short[] getOrCreateBlock(int index)
+        {
+            short[][] current = blocks;
+
+            if (index < current.Length)
+                return current[index];
+
+            var expanded = new short[index + 1][];
+            Array.Copy(current, expanded, current.Length);
+            for (int i = current.Length; i < expanded.Length; i++)
+                expanded[i] = new short[block_frames * Channels];
+
+            Volatile.Write(ref blocks, expanded);
+            return expanded[index];
+        }
+
+        [MethodImpl(MethodImplOptions.AggressiveInlining)]
+        private static short floatToShort(float value)
+        {
+            int v = (int)MathF.Round(value * 32767f);
+            return (short)Math.Clamp(v, short.MinValue, short.MaxValue);
+        }
+    }
+}
+
+#endif
diff --git a/osu.Framework/Audio/Web/PcmRenderer.cs b/osu.Framework/Audio/Web/PcmRenderer.cs
new file mode 100644
index 000000000..fa7f799be
--- /dev/null
+++ b/osu.Framework/Audio/Web/PcmRenderer.cs
@@ -0,0 +1,352 @@
+// Copyright (c) ppy Pty Ltd <contact@ppy.sh>. Licensed under the MIT Licence.
+// See the LICENCE file in the repository root for full licence text.
+
+#if OSU_WEB
+
+using System;
+
+namespace osu.Framework.Audio.Web
+{
+    /// <summary>
+    /// Renders <see cref="PcmData"/> at an arbitrary playback position, frequency (resampling; affects pitch and speed)
+    /// and tempo (time-stretching via WSOLA; affects speed only), producing interleaved stereo output.
+    /// </summary>
+    /// <remarks>
+    /// Not thread-safe. Owners are expected to synchronise access.
+    /// </remarks>
+    internal sealed class PcmRenderer
+    {
+        /// <summary>
+        /// Tempo values within this distance of 1 bypass time-stretching.
+        /// </summary>
+        private const double tempo_epsilon = 0.0005;
+
+        /// <summary>
+        /// The WSOLA synthesis hop (half the grain length), in seconds.
+        /// </summary>
+        private const double hop_seconds = 0.02;
+
+        /// <summary>
+        /// The maximum WSOLA alignment offset searched in either direction, in seconds.
+        /// </summary>
+        private const double search_seconds = 0.008;
+
+        /// <summary>
+        /// The decimation used when computing correlations.
+        /// </summary>
+        private const int correlation_stride = 4;
+
+        /// <summary>
+        /// The coarse step (in output frames) used when searching for the best alignment offset.
+        /// </summary>
+        private const int search_stride = 2;
+
+        public readonly PcmData Data;
+
+        /// <summary>
+        /// The logical playback position in (fractional) source frames.
+        /// </summary>
+        public double Position { get; private set; }
+
+        private int outputRate;
+
+        private int hopFrames;
+        private int searchFrames;
+
+        private float[] window = Array.Empty<float>();
+        private float[] grain = Array.Empty<float>();
+        private float[] tail = Array.Empty<float>();
+        private float[] hop = Array.Empty<float>();
+        private float[] reference = Array.Empty<float>();
+        private float[] candidates = Array.Empty<float>();
+
+        private int hopReadIndex;
+        private bool stretchPrimed;
+        private double lastGrainPosition;
+
+        public PcmRenderer(PcmData data)
+        {
+            Data = data;
+        }
+
+        /// <summary>
+        /// Moves the playback position, resetting any time-stretch state.
+        /// </summary>
+        public void SetPosition(double sourceFrame)
+        {
+            Position = Math.Max(0, sourceFrame);
+            ResetStretch();
+        }
+
+        /// <summary>
+        /// Discards any buffered time-stretch output.
+        /// </summary>
+        public void ResetStretch()
+        {
+            stretchPrimed = false;
+            hopReadIndex = hopFrames;
+        }
+
+        /// <summary>
+        /// Renders up to <paramref name="frames"/> output frames into <paramref name="destination"/> (interleaved stereo, overwritten).
+        /// </summary>
+        /// <param name="destination">The destination buffer.</param>
+        /// <param name="frames">The number of output frames requested.</param>
+        /// <param name="outputSampleRate">The output sample rate.</param>
+        /// <param name="frequency">The relative frequency (1 = original pitch and speed).</param>
+        /// <param name="tempo">The relative tempo (1 = original speed).</param>
+        /// <param name="endFrame">The source frame at which playback ends.</param>
+        /// <param name="stalled">Set to true if rendering stopped early because the required data has not been decoded yet.</param>
+        /// <returns>The number of frames rendered. Fewer than requested if the end was reached or data was unavailable.</returns>
+        public int Render(Span<float> destination, int frames, int outputSampleRate, double frequency, double tempo, long endFrame, out bool stalled)
+        {
+            stalled = false;
+
+            double step = frequency * Data.SampleRate / outputSampleRate;
+            double advance = step * tempo;
+
+            if (step <= 0 || advance <= 0)
+                return 0;
+
+            long available = Data.DecodedFrames;
+            bool complete = Data.IsComplete;
+
+            if (Math.Abs(tempo - 1) < tempo_epsilon)
+            {
+                if (stretchPrimed)
+                    ResetStretch();
+
+                // how many output frames until the end of the track, and until the end of the decoded data (+1 frame for interpolation).
+                int toEnd = framesUntil(endFrame, step);
+                int rendered = Math.Min(frames, toEnd);
+
+                if (!complete)
+                {
+                    int toAvailable = framesUntil(available - 1, step);
+
+                    if (toAvailable < rendered)
+                    {
+                        rendered = toAvailable;
+                        stalled = true;
+                    }
+                }
+
+                if (rendered <= 0)
+                    return 0;
+
+                Data.ReadResampled(Position, step, destination, rendered, available);
+                Position += rendered * step;
+                return rendered;
+            }
+
+            ensureStretchBuffers(outputSampleRate);
+
+            int produced = 0;
+
+            while (produced < frames)
+            {
+                if (Position >= endFrame)
+                    break;
+
+                if (hopReadIndex >= hopFrames)
+                {
+                    // the next grain covers 2 hops worth of output, plus the search region.
+                    double required = Position + (2 * hopFrames + searchFrames + 2) * step;
+
+                    if (!complete && required >= available && Position + 2 < endFrame)
+                    {
+                        stalled = true;
+                        break;
+                    }
+
+                    computeNextHop(step, tempo, available);
+                }
+
+                int count = Math.Min(frames - produced, hopFrames - hopReadIndex);
+
+                // don't run past the end of the track.
+                int toEnd = framesUntil(endFrame, advance);
+                count = Math.Min(count, Math.Max(1, toEnd));
+
+                hop.AsSpan(hopReadIndex * 2, count * 2).CopyTo(destination.Slice(produced * 2));
+
+                hopReadIndex += count;
+                produced += count;
+                Position += count * advance;
+            }
+
+            return produced;
+        }
+
+        /// <summary>
+        /// The number of output frames that can be rendered from <see cref="Position"/> before reaching <paramref name="frame"/>.
+        /// </summary>
+        private int framesUntil(double frame, double step)
+        {
+            double remaining = (frame - Position) / step;
+            if (remaining <= 0)
+                return 0;
+
+            return (int)Math.Min(int.MaxValue, Math.Ceiling(remaining));
+        }
+
+        private void ensureStretchBuffers(int sampleRate)
+        {
+            if (sampleRate == outputRate)
+                return;
+
+            outputRate = sampleRate;
+            hopFrames = Math.Max(64, (int)(sampleRate * hop_seconds));
+            searchFrames = Math.Max(8, (int)(sampleRate * search_seconds));
+
+            int grainFrames = hopFrames * 2;
+
+            // periodic hann window - window[n] + window[n + hop] == 1, giving constant gain when overlap-added.
+            window = new float[grainFrames];
+            for (int i = 0; i < grainFrames; i++)
+                window[i] = (float)(0.5 - 0.5 * Math.Cos(2 * Math.PI * i / grainFrames));
+
+            grain = new float[grainFrames * 2];
+            tail = new float[hopFrames * 2];
+            hop = new float[hopFrames * 2];
+            reference = new float[hopFrames * 2];
+            candidates = new float[(hopFrames + 2 * searchFrames) * 2];
+
+            ResetStretch();
+        }
+
+        /// <summary>
+        /// Computes the next <see cref="hopFrames"/> frames of time-stretched output into <see cref="hop"/>.
+        /// </summary>
+        private void computeNextHop(double step, double tempo, long available)
+        {
+            double nominal = Position;
+            double grainPosition = nominal;
+
+            if (!stretchPrimed)
+            {
+                // Pretend the previous grain was a perfect continuation of this one, such that the first hop is the unmodified source audio.
+                Data.ReadResampled(nominal, step, grain, hopFrames, available);
+                for (int i = 0; i < hopFrames; i++)
+                {
+                    float w = window[i + hopFrames];
+                    tail[i * 2] = grain[i * 2] * w;
+                    tail[i * 2 + 1] = grain[i * 2 + 1] * w;
+                }
+
+                stretchPrimed = true;
+            }
+            else
+                grainPosition = findBestPosition(nominal, step, available);
+
+            lastGrainPosition = grainPosition;
+
+            int grainFrames = hopFrames * 2;
+            Data.ReadResampled(grainPosition, step, grain, grainFrames, available);
+
+            for (int i = 0; i < hopFrames; i++)
+            {
+                float w = window[i];
+                hop[i * 2] = tail[i * 2] + grain[i * 2] * w;
+                hop[i * 2 + 1] = tail[i * 2 + 1] + grain[i * 2 + 1] * w;
+            }
+
+            for (int i = 0; i < hopFrames; i++)
+            {
+                float w = window[i + hopFrames];
+                tail[i * 2] = grain[(i + hopFrames) * 2] * w;
+                tail[i * 2 + 1] = grain[(i + hopFrames) * 2 + 1] * w;
+            }
+
+            hopReadIndex = 0;
+        }
+
+        /// <summary>
+        /// Finds the grain start position near <paramref name="nominal"/> which best continues the previous grain.
+        /// </summary>
+        private double findBestPosition(double nominal, double step, long available)
+        {
+            // The natural continuation of the previous grain - what would seamlessly follow its overlapping half.
+            double natural = lastGrainPosition + hopFrames * step;
+
+            readForCorrelation(natural, step, reference, hopFrames, available);
+
+            double searchStart = nominal - searchFrames * step;
+            if (searchStart < 0)
+                searchStart = 0;
+
+            int candidateFrames = candidates.Length / 2;
+            readForCorrelation(searchStart, step, candidates, candidateFrames, available);
+
+            int maxOffset = candidateFrames - hopFrames;
+
+            int bestOffset = coarseSearch(maxOffset);
+
+            // refine around the coarse result.
+            int refineStart = Math.Max(0, bestOffset - search_stride + 1);
+            int refineEnd = Math.Min(maxOffset, bestOffset + search_stride - 1);
+            double best = double.MinValue;
+
+            for (int offset = refineStart; offset <= refineEnd; offset++)
+            {
+                double score = correlate(offset);
+
+                if (score > best)
+                {
+                    best = score;
+                    bestOffset = offset;
+                }
+            }
+
+            return searchStart + bestOffset * step;
+        }
+
+        private int coarseSearch(int maxOffset)
+        {
+            int bestOffset = Math.Min(searchFrames, maxOffset);
+            double best = double.MinValue;
+
+            for (int offset = 0; offset <= maxOffset; offset += search_stride)
+            {
+                double score = correlate(offset);
+
+                if (score > best)
+                {
+                    best = score;
+                    bestOffset = offset;
+                }
+            }
+
+            return bestOffset;
+        }
+
+        private double correlate(int offset)
+        {
+            float cross = 0;
+            float energy = 1e-9f;
+
+            // both channels are correlated separately, as downmixing could cancel out (e.g. phase-inverted channels).
+            for (int j = 0; j < hopFrames; j += correlation_stride)
+            {
+                float cl = candidates[(offset + j) * 2];
+                float cr = candidates[(offset + j) * 2 + 1];
+                cross += reference[j * 2] * cl + reference[j * 2 + 1] * cr;
+                energy += cl * cl + cr * cr;
+            }
+
+            return cross / MathF.Sqrt(energy);
+        }
+
+        private void readForCorrelation(double position, double step, float[] destination, int frames, long available)
+        {
+            for (int i = 0; i < frames; i++)
+            {
+                // nearest-neighbour is sufficient for alignment purposes.
+                long index = (long)(position + i * step);
+                Data.GetFrame(index, available, out destination[i * 2], out destination[i * 2 + 1]);
+            }
+        }
+    }
+}
+
+#endif
diff --git a/osu.Framework/Audio/Web/WebAudioEngine.cs b/osu.Framework/Audio/Web/WebAudioEngine.cs
new file mode 100644
index 000000000..e33b156b4
--- /dev/null
+++ b/osu.Framework/Audio/Web/WebAudioEngine.cs
@@ -0,0 +1,302 @@
+// Copyright (c) ppy Pty Ltd <contact@ppy.sh>. Licensed under the MIT Licence.
+// See the LICENCE file in the repository root for full licence text.
+
+#if OSU_WEB
+
+using System;
+using System.Collections.Generic;
+using System.Runtime.Versioning;
+using System.Threading;
+using osu.Framework.Audio.Mixing.Web;
+using osu.Framework.Logging;
+
+namespace osu.Framework.Audio.Web
+{
+    /// <summary>
+    /// Parameters of a single mix pass, provided to channels by the mixer thread.
+    /// </summary>
+    internal readonly struct WebMixContext
+    {
+        /// <summary>
+        /// The output sample rate.
+        /// </summary>
+        public readonly int SampleRate;
+
+        /// <summary>
+        /// The output write frame at which the first frame of this pass will be written.
+        /// </summary>
+        public readonly int StartWriteFrame;
+
+        /// <summary>
+        /// The number of frames in this pass.
+        /// </summary>
+        public readonly int Frames;
+
+        public WebMixContext(int sampleRate, int startWriteFrame, int frames)
+        {
+            SampleRate = sampleRate;
+            StartWriteFrame = startWriteFrame;
+            Frames = frames;
+        }
+
+        /// <summary>
+        /// The output write frame following the last frame of this pass.
+        /// </summary>
+        public int EndWriteFrame => unchecked(StartWriteFrame + Frames);
+    }
+
+    /// <summary>
+    /// The global browser audio engine: owns the audio output and a dedicated mixer thread which pulls audio from all <see cref="WebAudioMixer"/>s.
+    /// </summary>
+    public static class WebAudioEngine
+    {
+        /// <summary>
+        /// The amount of audio kept buffered ahead of the audio device, in milliseconds.
+        /// </summary>
+        public const int TARGET_LATENCY_MS = 40;
+
+        /// <summary>
+        /// The number of frames mixed per pass.
+        /// </summary>
+        public const int CHUNK_FRAMES = 256;
+
+        /// <summary>
+        /// How long the mixer thread sleeps between checks when the buffer is sufficiently full.
+        /// </summary>
+        private const int mixer_sleep_ms = 2;
+
+        private const int fallback_sample_rate = 48000;
+
+        private static readonly Lock init_lock = new Lock();
+        private static readonly Lock mix_lock = new Lock();
+        private static readonly Lock mixers_lock = new Lock();
+
+        private static readonly List<WebAudioMixer> mixers = new List<WebAudioMixer>();
+        private static WebAudioMixer[] mixerSnapshot = Array.Empty<WebAudioMixer>();
+
+        private static readonly float[] master_buffer = new float[CHUNK_FRAMES * 2];
+
+        private static volatile WebAudioOutput? output;
+        private static Thread? mixerThread;
+        private static volatile bool offline;
+
+        private static int targetLatencyFrames;
+
+        /// <summary>
+        /// Whether audio is being output to a real device (the page's AudioWorklet), as opposed to a silent fallback.
+        /// </summary>
+        public static bool HasDevice => output is RingBufferAudioOutput;
+
+        /// <summary>
+        /// The output sample rate.
+        /// </summary>
+        public static int SampleRate => Output.SampleRate;
+
+        internal static WebAudioOutput Output
+        {
+            get
+            {
+                EnsureInitialised();
+                return output!;
+            }
+        }
+
+        /// <summary>
+        /// The total number of frames played by the output device.
+        /// </summary>
+        internal static int ReadFrame => Output.ReadFrame;
+
+        /// <summary>
+        /// The total number of frames written to the output device.
+        /// </summary>
+        internal static int WriteFrame => Output.WriteFrame;
+
+        /// <summary>
+        /// Initialises the output and starts the mixer thread, if not already done.
+        /// Should first be called from the game thread, since the page's JavaScript functions are invoked from the calling thread.
+        /// </summary>
+        public static void EnsureInitialised()
+        {
+            if (output != null)
+                return;
+
+            lock (init_lock)
+            {
+                if (output != null)
+                    return;
+
+                output = createOutput();
+                targetLatencyFrames = (output.SampleRate * TARGET_LATENCY_MS / 1000 + CHUNK_FRAMES - 1) / CHUNK_FRAMES * CHUNK_FRAMES;
+
+                if (!offline)
+                {
+                    mixerThread = new Thread(mixerLoop)
+                    {
+                        Name = "WebAudioMixer",
+                        IsBackground = true,
+                    };
+
+                    mixerThread.Start();
+                }
+            }
+        }
+
+        /// <summary>
+        /// Switches the engine to offline rendering, for testing purposes. The mixer thread is stopped and audio is only produced via <see cref="RenderOffline"/>.
+        /// Must be called before any audio components are created.
+        /// </summary>
+        public static void UseOfflineRendering(int sampleRate)
+        {
+            lock (init_lock)
+            {
+                offline = true;
+                output = new OfflineAudioOutput(sampleRate);
+            }
+        }
+
+        /// <summary>
+        /// Renders audio into <paramref name="destination"/> (interleaved stereo) when in offline mode. The audio is considered to be played immediately.
+        /// </summary>
+        public static void RenderOffline(float[] destination, int frames)
+        {
+            if (!(output is OfflineAudioOutput offlineOutput))
+                throw new InvalidOperationException($"{nameof(UseOfflineRendering)} must be called first.");
+
+            if (destination.Length < frames * 2)
+                throw new ArgumentException("Destination is too small.", nameof(destination));
+
+            lock (mix_lock)
+            {
+                offlineOutput.Destination = destination;
+                offlineOutput.DestinationOffset = 0;
+
+                for (int done = 0; done < frames;)
+                {
+                    int count = Math.Min(CHUNK_FRAMES, frames - done);
+                    mixChunk(offlineOutput, count);
+                    done += count;
+                }
+
+                offlineOutput.Destination = null;
+            }
+        }
+
+        internal static void Register(WebAudioMixer mixer)
+        {
+            EnsureInitialised();
+
+            lock (mixers_lock)
+            {
+                if (mixers.Contains(mixer))
+                    return;
+
+                mixers.Add(mixer);
+                mixerSnapshot = mixers.ToArray();
+            }
+        }
+
+        internal static void Unregister(WebAudioMixer mixer)
+        {
+            lock (mixers_lock)
+            {
+                if (mixers.Remove(mixer))
+                    mixerSnapshot = mixers.ToArray();
+            }
+        }
+
+        private static WebAudioOutput createOutput()
+        {
+            if (offline && output != null)
+                return output;
+
+            int capacity = (int)Math.Min(1 << 16, 4L * fallback_sample_rate * TARGET_LATENCY_MS / 1000);
+
+            if (OperatingSystem.IsBrowser())
+            {
+                try
+                {
+                    return createBrowserOutput();
+                }
+                catch (Exception e)
+                {
+                    Logger.Log($"Web audio output could not be initialised, audio will be silent: {e.Message}", level: LogLevel.Important);
+                }
+            }
+            else
+                Logger.Log("Not running in a browser, audio will be silent.");
+
+            return new NullAudioOutput(fallback_sample_rate, capacity);
+        }
+
+        [SupportedOSPlatform("browser")]
+        private static WebAudioOutput createBrowserOutput()
+        {
+            int sampleRate = WebAudioInterop.AudioGetSampleRate();
+
+            if (sampleRate < 8000 || sampleRate > 384000)
+                throw new InvalidOperationException($"Invalid output sample rate ({sampleRate}).");
+
+            // Allow plenty of headroom above the target latency.
+            var ringBuffer = new RingBufferAudioOutput(sampleRate, sampleRate * TARGET_LATENCY_MS / 1000 * 4);
+
+            WebAudioInterop.AudioAttach(ringBuffer.Address, ringBuffer.CapacityFrames, sampleRate);
+
+            Logger.Log($"🔈 Web audio initialised ({sampleRate} Hz, {ringBuffer.CapacityFrames} frame ring buffer, {TARGET_LATENCY_MS} ms target latency)");
+
+            return ringBuffer;
+        }
+
+        private static void mixerLoop()
+        {
+            int consecutiveErrors = 0;
+
+            while (!offline)
+            {
+                try
+                {
+                    var target = output!;
+
+                    int buffered = unchecked(target.WriteFrame - target.ReadFrame);
+
+                    // Never exceed the target (and therefore the ring capacity). If the consumer stops (e.g. suspended AudioContext), mixing pauses as well.
+                    if (buffered >= 0 && buffered + CHUNK_FRAMES <= Math.Min(targetLatencyFrames, target.CapacityFrames))
+                    {
+                        lock (mix_lock)
+                            mixChunk(target, CHUNK_FRAMES);
+
+                        consecutiveErrors = 0;
+                        continue;
+                    }
+                }
+                catch (Exception e)
+                {
+                    // avoid flooding logs if something is persistently broken.
+                    if (consecutiveErrors++ < 5)
+                        Logger.Error(e, "Web audio mixing failed");
+                }
+
+                Thread.Sleep(mixer_sleep_ms);
+            }
+        }
+
+        private static void mixChunk(WebAudioOutput target, int frames)
+        {
+            var span = master_buffer.AsSpan(0, frames * 2);
+            span.Clear();
+
+            var context = new WebMixContext(target.SampleRate, target.WriteFrame, frames);
+
+            var currentMixers = mixerSnapshot;
+
+            for (int i = 0; i < currentMixers.Length; i++)
+                currentMixers[i].MixInto(master_buffer, context);
+
+            for (int i = 0; i < span.Length; i++)
+                span[i] = Math.Clamp(span[i], -1f, 1f);
+
+            target.Write(span, frames);
+        }
+    }
+}
+
+#endif
