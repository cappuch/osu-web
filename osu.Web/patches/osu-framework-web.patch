@@ -0,0 +1,101 @@
+// Copyright (c) ppy Pty Ltd <contact@ppy.sh>. Licensed under the MIT Licence.
+// See the LICENCE file in the repository root for full licence text.
+
+#if OSU_WEB
+
+using System.Collections.Generic;
+using osuTK.Input;
+
+namespace osu.Framework.Platform.Web
+{
+    /// <summary>
+    /// Maps DOM <c>KeyboardEvent.code</c> values (physical key locations) to osuTK keys.
+    /// </summary>
+    internal static class WebKeyMapping
+    {
+        private static readonly Dictionary<string, Key> map = new Dictionary<string, Key>
+        {
+            ["Escape"] = Key.Escape,
+            ["Enter"] = Key.Enter,
+            ["NumpadEnter"] = Key.KeypadEnter,
+            ["Space"] = Key.Space,
+            ["Backspace"] = Key.BackSpace,
+            ["Tab"] = Key.Tab,
+            ["ShiftLeft"] = Key.ShiftLeft,
+            ["ShiftRight"] = Key.ShiftRight,
+            ["ControlLeft"] = Key.ControlLeft,
+            ["ControlRight"] = Key.ControlRight,
+            ["AltLeft"] = Key.AltLeft,
+            ["AltRight"] = Key.AltRight,
+            ["MetaLeft"] = Key.WinLeft,
+            ["MetaRight"] = Key.WinRight,
+            ["OSLeft"] = Key.WinLeft,
+            ["OSRight"] = Key.WinRight,
+            ["ContextMenu"] = Key.Menu,
+            ["ArrowUp"] = Key.Up,
+            ["ArrowDown"] = Key.Down,
+            ["ArrowLeft"] = Key.Left,
+            ["ArrowRight"] = Key.Right,
+            ["Insert"] = Key.Insert,
+            ["Delete"] = Key.Delete,
+            ["Home"] = Key.Home,
+            ["End"] = Key.End,
+            ["PageUp"] = Key.PageUp,
+            ["PageDown"] = Key.PageDown,
+            ["CapsLock"] = Key.CapsLock,
+            ["ScrollLock"] = Key.ScrollLock,
+            ["NumLock"] = Key.NumLock,
+            ["PrintScreen"] = Key.PrintScreen,
+            ["Pause"] = Key.Pause,
+            ["Backquote"] = Key.Tilde,
+            ["Minus"] = Key.Minus,
+            ["Equal"] = Key.Plus,
+            ["BracketLeft"] = Key.BracketLeft,
+            ["BracketRight"] = Key.BracketRight,
+            ["Backslash"] = Key.BackSlash,
+            ["IntlBackslash"] = Key.NonUSBackSlash,
+            ["Semicolon"] = Key.Semicolon,
+            ["Quote"] = Key.Quote,
+            ["Comma"] = Key.Comma,
+            ["Period"] = Key.Period,
+            ["Slash"] = Key.Slash,
+            ["NumpadDivide"] = Key.KeypadDivide,
+            ["NumpadMultiply"] = Key.KeypadMultiply,
+            ["NumpadSubtract"] = Key.KeypadMinus,
+            ["NumpadAdd"] = Key.KeypadPlus,
+            ["NumpadDecimal"] = Key.KeypadDecimal,
+            ["AudioVolumeMute"] = Key.Mute,
+            ["AudioVolumeDown"] = Key.VolumeDown,
+            ["AudioVolumeUp"] = Key.VolumeUp,
+            ["MediaPlayPause"] = Key.PlayPause,
+            ["MediaStop"] = Key.Stop,
+            ["MediaTrackNext"] = Key.TrackNext,
+            ["MediaTrackPrevious"] = Key.TrackPrevious,
+        };
+
+        static WebKeyMapping()
+        {
+            for (char c = 'A'; c <= 'Z'; c++)
+                map[$"Key{c}"] = Key.A + (c - 'A');
+
+            for (int i = 0; i <= 9; i++)
+            {
+                map[$"Digit{i}"] = Key.Number0 + i;
+                map[$"Numpad{i}"] = Key.Keypad0 + i;
+            }
+
+            for (int i = 1; i <= 24; i++)
+                map[$"F{i}"] = Key.F1 + (i - 1);
+        }
+
+        public static Key FromCode(string? code)
+        {
+            if (code != null && map.TryGetValue(code, out var key))
+                return key;
+
+            return Key.Unknown;
+        }
+    }
+}
