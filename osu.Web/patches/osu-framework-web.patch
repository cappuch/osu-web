+        public static byte[] HashData(ReadOnlySpan<byte> source)
+        {
+            var hash = new IncrementalHash();
+            hash.Append(source);
+            return hash.GetHashAndReset();
+        }
+
+        public static byte[] HashData(Stream source)
+        {
+            var hash = new IncrementalHash();
+            byte[] buffer = new byte[8192];
+            int read;
+
+            while ((read = source.Read(buffer, 0, buffer.Length)) > 0)
+                hash.Append(buffer.AsSpan(0, read));
+
+            return hash.GetHashAndReset();
+        }
+
+        private sealed class IncrementalHash
+        {
+            private readonly byte[] remainder = new byte[64];
+            private int remainderLength;
+            private ulong totalLength;
+
+            private uint a = 0x67452301;
+            private uint b = 0xefcdab89;
+            private uint c = 0x98badcfe;
+            private uint d = 0x10325476;
+
+            public void Append(ReadOnlySpan<byte> source)
+            {
+                totalLength += (ulong)source.Length;
+
+                if (remainderLength > 0)
+                {
+                    int copied = Math.Min(64 - remainderLength, source.Length);
+                    source[..copied].CopyTo(remainder.AsSpan(remainderLength));
+                    remainderLength += copied;
+                    source = source[copied..];
+
+                    if (remainderLength == 64)
+                    {
+                        processBlock(remainder);
+                        remainderLength = 0;
+                    }
+                }
+
+                while (source.Length >= 64)
+                {
+                    processBlock(source[..64]);
+                    source = source[64..];
+                }
+
+                if (!source.IsEmpty)
+                {
+                    source.CopyTo(remainder);
+                    remainderLength = source.Length;
+                }
+            }
+
+            public byte[] GetHashAndReset()
+            {
+                ulong bitLength = totalLength * 8;
+                int paddingLength = remainderLength < 56 ? 56 - remainderLength : 120 - remainderLength;
+                Span<byte> final = stackalloc byte[paddingLength + 8];
+                final.Clear();
+                final[0] = 0x80;
+                BinaryPrimitives.WriteUInt64LittleEndian(final[^8..], bitLength);
+                Append(final);
+
+                var result = new byte[16];
+                BinaryPrimitives.WriteUInt32LittleEndian(result.AsSpan(0, 4), a);
+                BinaryPrimitives.WriteUInt32LittleEndian(result.AsSpan(4, 4), b);
+                BinaryPrimitives.WriteUInt32LittleEndian(result.AsSpan(8, 4), c);
+                BinaryPrimitives.WriteUInt32LittleEndian(result.AsSpan(12, 4), d);
+                return result;
+            }
+
+            private void processBlock(ReadOnlySpan<byte> block)
+            {
+                Span<uint> words = stackalloc uint[16];
+
+                for (int i = 0; i < words.Length; i++)
+                    words[i] = BinaryPrimitives.ReadUInt32LittleEndian(block.Slice(i * 4, 4));
+
+                uint aa = a;
+                uint bb = b;
+                uint cc = c;
+                uint dd = d;
+
+                unchecked
+                {
+                    for (int i = 0; i < 64; i++)
+                    {
+                        uint f;
+                        int word;
+
+                        if (i < 16)
+                        {
+                            f = (bb & cc) | (~bb & dd);
+                            word = i;
+                        }
+                        else if (i < 32)
+                        {
+                            f = (dd & bb) | (~dd & cc);
+                            word = (5 * i + 1) % 16;
+                        }
+                        else if (i < 48)
+                        {
+                            f = bb ^ cc ^ dd;
+                            word = (3 * i + 5) % 16;
+                        }
+                        else
+                        {
+                            f = cc ^ (bb | ~dd);
+                            word = (7 * i) % 16;
+                        }
+
+                        uint previousD = dd;
+                        dd = cc;
+                        cc = bb;
+                        bb += BitOperations.RotateLeft(aa + f + constants[i] + words[word], shifts[i]);
+                        aa = previousD;
+                    }
+
+                    a += aa;
+                    b += bb;
+                    c += cc;
+                    d += dd;
+                }
+            }
+        }
+    }
