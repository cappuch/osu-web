+// Copyright (c) ppy Pty Ltd <contact@ppy.sh>. Licensed under the MIT Licence.
+// See the LICENCE file in the repository root for full licence text.
+
+#if OSU_WEB
+
+using System.Collections.Generic;
+using System.Threading;
+using osu.Framework.Audio.Mixing.Web;
+using osu.Framework.Audio.Web;
+using osu.Framework.Bindables;
+using osu.Framework.Logging;
+
+namespace osu.Framework.Audio.Sample
+{
+    /// <summary>
+    /// A factory for <see cref="SampleWeb"/> objects sharing common decoded audio data (and thus playback concurrency).
+    /// </summary>
+    internal class SampleWebFactory : AudioCollectionManager<AdjustableAudioComponent>
+    {
+        /// <summary>
+        /// A name identifying the sample to be created by this factory.
+        /// </summary>
+        public string Name { get; }
+
+        /// <summary>
+        /// The decoded audio data, or <c>null</c> if decoding failed.
+        /// </summary>
+        public PcmData? Data { get; }
+
+        public override bool IsLoaded => Data != null;
+
+        public double Length { get; }
+
+        /// <summary>
+        /// The maximum number of channels of this sample which may play concurrently.
+        /// When exceeded, the longest-playing channel is stopped (matching BASS's <c>BASS_SAMPLE_OVER_POS</c>).
+        /// </summary>
+        internal readonly Bindable<int> PlaybackConcurrency = new Bindable<int>(Sample.DEFAULT_CONCURRENCY);
+
+        private readonly WebAudioMixer mixer;
+
+        private readonly Lock playbackLock = new Lock();
+
+        /// <summary>
+        /// Currently playing channels, ordered by playback start time.
+        /// </summary>
+        private readonly List<SampleChannelWeb> activePlaybacks = new List<SampleChannelWeb>();
+
+        public SampleWebFactory(byte[] data, string name, WebAudioMixer mixer)
+        {
+            this.mixer = mixer;
+
+            Name = name;
+
+            Data = AudioDecoder.DecodeAll(data, out string? error);
+
+            if (error != null)
+                Logger.Log($"Failed to decode sample \"{name}\": {error}", level: LogLevel.Important);
+
+            if (Data != null)
+                Length = Data.LengthMilliseconds;
+        }
+
+        public Sample CreateSample() => new SampleWeb(this, mixer) { OnPlay = onPlay };
+
+        private void onPlay(Sample sample)
+        {
+            AddItem(sample);
+        }
+
+        /// <summary>
+        /// Registers the start of playback of a channel, stopping the longest-playing channel if the concurrency limit is exceeded.
+        /// </summary>
+        internal void RegisterPlayback(SampleChannelWeb channel)
+        {
+            SampleChannelWeb? overridden = null;
+
+            lock (playbackLock)
+            {
+                activePlaybacks.RemoveAll(c => !c.IsMixing);
+                activePlaybacks.Remove(channel);
+
+                if (activePlaybacks.Count >= System.Math.Max(1, PlaybackConcurrency.Value))
+                {
+                    overridden = activePlaybacks[0];
+                    activePlaybacks.RemoveAt(0);
+                }
+
+                activePlaybacks.Add(channel);
+            }
+
+            overridden?.StopOverridden();
+        }
+
+        internal void UnregisterPlayback(SampleChannelWeb channel)
+        {
+            lock (playbackLock)
+                activePlaybacks.Remove(channel);
+        }
+    }
+}
+
+#endif
