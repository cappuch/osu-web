@@ -0,0 +1,519 @@
+// Copyright (c) ppy Pty Ltd <contact@ppy.sh>. Licensed under the MIT Licence.
+// See the LICENCE file in the repository root for full licence text.
+
+#if OSU_WEB
+
+using System;
+using System.Collections.Generic;
+using System.Collections.Immutable;
+using System.Drawing;
+using System.IO;
+using System.Runtime.Versioning;
+using System.Threading;
+using System.Threading.Tasks;
+using osu.Framework.Bindables;
+using osu.Framework.Configuration;
+using osu.Framework.Extensions.EnumExtensions;
+using osu.Framework.Graphics;
+using osu.Framework.Input;
+using osu.Framework.Logging;
+using osuTK.Input;
+using RectangleF = osu.Framework.Graphics.Primitives.RectangleF;
+
+namespace osu.Framework.Platform.Web
+{
+    /// <summary>
+    /// A "window" backed by the page's canvas element.
+    /// Rendering happens directly into the page canvas, transferred once to this thread.
+    /// </summary>
+    [SupportedOSPlatform("browser")]
+    public class WebWindow : IWindow, IGraphicsSurface, IOpenGLGraphicsSurface
+    {
+        private volatile bool exitRequested;
+        private bool isVisible = true;
+        private bool isDisposed;
+
+        private int glContext;
+
+        private Size drawableSize = new Size(1280, 720);
+        private Size glCanvasSize;
+
+        public WebWindow()
+        {
+            var mode = new DisplayMode(null, drawableSize, 32, 60, 0);
+            PrimaryDisplay = new Display(0, "Browser", new Rectangle(Point.Empty, drawableSize), new Rectangle(Point.Empty, drawableSize), new[] { mode });
+            Displays = ImmutableArray.Create(PrimaryDisplay);
+            CurrentDisplayBindable.Value = PrimaryDisplay;
+            currentDisplayMode.Value = mode;
+
+            WindowMode.BindValueChanged(m => WebHostInterop.SetFullscreen(m.NewValue != Configuration.WindowMode.Windowed));
+        }
+
+        #region Events consumed by input handlers
+
+        internal event Action<osuTK.Vector2>? MouseMove;
+        internal event Action<osuTK.Vector2>? MouseMoveRelative;
+        internal event Action<MouseButton>? MouseDown;
+        internal event Action<MouseButton>? MouseUp;
+        internal event Action<osuTK.Vector2, bool>? MouseWheel;
+        internal event Action<Key>? KeyDown;
+        internal event Action<Key>? KeyUp;
+        internal event Action<string>? TextInput;
+        internal event Action<int, osuTK.Vector2>? TouchDown;
+        internal event Action<int, osuTK.Vector2>? TouchMove;
+        internal event Action<int, osuTK.Vector2>? TouchUp;
+
+        #endregion
+
+        #region IWindow
+
+        IGraphicsSurface IWindow.GraphicsSurface => this;
+
+        public void CycleMode() => WindowMode.Value = WindowMode.Value == Configuration.WindowMode.Windowed ? Configuration.WindowMode.Fullscreen : Configuration.WindowMode.Windowed;
+
+        public void SetupWindow(FrameworkConfigManager config)
+        {
+            config.BindWith(FrameworkSetting.WindowMode, WindowMode);
+        }
+
+        public void Create()
+        {
+            // Pick up the canvas size reported by the page before the context is created.
+            processEvents();
+        }
+
+        public void Run()
+        {
+            while (!exitRequested)
+            {
+                processEvents();
+                Update?.Invoke();
+            }
+
+            Exited?.Invoke();
+        }
+
+        /// <summary>
+        /// The synchronisation context of the game thread's JS event loop (captured before osu!framework installs its own).
+        /// </summary>
+        internal static SynchronizationContext? WorkerContext;
+
+        /// <summary>
+        /// Runs the frame loop, returning to the worker's event loop between frames.
+        /// Browser resources created on this thread (e.g. presented frames) are only released from that event loop.
+        /// </summary>
+        /// <remarks>
+        /// Each frame is posted to <see cref="WorkerContext"/> rather than awaited, as await continuations
+        /// may resume on a thread-pool thread which has no GL context.
+        /// </remarks>
+        public Task RunAsync()
+        {
+            var context = WorkerContext ?? throw new InvalidOperationException($"{nameof(WorkerContext)} must be set before running.");
+            int gameThreadId = Environment.CurrentManagedThreadId;
+            var completion = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
+
+            void frame(object? _)
+            {
+                try
+                {
+                    if (exitRequested)
+                    {
+                        Exited?.Invoke();
+                        completion.TrySetResult();
+                        return;
+                    }
+
+                    processEvents();
+                    Update?.Invoke();
+
+                    // The promise continuation may run on a pool worker. Send it synchronously to the GL-owning
+                    // JS worker; Post uses a clamped timer path which adds roughly 4ms to every frame in Chromium.
+                    WebWorkerInterop.NextFrame().ContinueWith(_ =>
+                    {
+                        if (Environment.CurrentManagedThreadId == gameThreadId)
+                            frame(null);
+                        else
+                            context.Send(frame, null);
+                    }, TaskContinuationOptions.ExecuteSynchronously);
+                }
+                catch (Exception e)
+                {
+                    completion.TrySetException(e);
+                }
+            }
+
+            context.Post(frame, null);
+            return completion.Task;
+        }
+
+        public void OnDraw()
+        {
+        }
+
+        public void Close() => exitRequested = true;
+
+        public event Action? Update;
+#pragma warning disable CS0067
+        public event Action? ExitRequested;
+        public event Action? Exited;
+        public event Action? Suspended;
+        public event Action? Resumed;
+        public event Action? LowOnMemory;
+        public event Action? Resized;
+        public event Action? KeymapChanged;
+        public event Action<string>? DragDrop;
+#pragma warning restore CS0067
+
+        private readonly BindableBool cursorInWindow = new BindableBool(true);
+        public IBindable<bool> CursorInWindow => cursorInWindow;
+
+        private CursorState cursorState;
+
+        public CursorState CursorState
+        {
+            get => cursorState;
+            set
+            {
+                if (cursorState == value)
+                    return;
+
+                cursorState = value;
+                WebHostInterop.SetCursorVisible(!value.HasFlagFast(CursorState.Hidden));
+            }
+        }
+
+        public RectangleF? CursorConfineRect { get; set; }
+
+        public WindowState WindowState { get; set; } = WindowState.Normal;
+
+#pragma warning disable CS0067
+        public event Action<WindowState>? WindowStateChanged;
+        public event Action<IEnumerable<Display>>? DisplaysChanged;
+#pragma warning restore CS0067
+
+        public WindowMode DefaultWindowMode => Configuration.WindowMode.Windowed;
+
+        private readonly BindableBool isActive = new BindableBool(true);
+        public IBindable<bool> IsActive => isActive;
+
+        public BindableSafeArea SafeAreaPadding { get; } = new BindableSafeArea();
+
+        public IBindable<MarginPadding> BorderSize { get; } = new Bindable<MarginPadding>();
+
+        public IEnumerable<WindowMode> SupportedWindowModes { get; } = new[] { Configuration.WindowMode.Windowed, Configuration.WindowMode.Fullscreen };
+
+        public Bindable<WindowMode> WindowMode { get; } = new Bindable<WindowMode>();
+
+        public ImmutableArray<Display> Displays { get; }
+
+        public Display PrimaryDisplay { get; }
+
+        public Bindable<Display> CurrentDisplayBindable { get; } = new Bindable<Display>();
+
+        private readonly Bindable<DisplayMode> currentDisplayMode = new Bindable<DisplayMode>();
+        public IBindable<DisplayMode> CurrentDisplayMode => currentDisplayMode;
+
+        public void Raise()
+        {
+        }
+
+        public void Hide()
+        {
+        }
+
+        public void Show()
+        {
+        }
+
+        public void Flash(bool flashUntilFocused = false)
+        {
+        }
+
+        public void CancelFlash()
+        {
+        }
+
+        public void EnableScreenSuspension()
+        {
+        }
+
+        public void DisableScreenSuspension()
+        {
+        }
+
+        [Obsolete("Use IWindow.IsActive.Value instead.")]
+        public bool Focused => isActive.Value;
+
+        public void SetIconFromStream(Stream imageStream)
+        {
+        }
+
+        [Obsolete("This member should not be used.")]
+        public Point PointToClient(Point point) => point;
+
+        [Obsolete("This member should not be used.")]
+        public Point PointToScreen(Point point) => point;
+
+        public Size ClientSize => drawableSize;
+        public Point Position => Point.Empty;
+        public bool PositionAccurate => true;
+        public Size Size => drawableSize;
+        public float Scale { get; private set; } = 1;
+        public Size MinSize { get; set; }
+        public Size MaxSize { get; set; }
+        public bool Resizable { get; set; } = true;
+
+        private string title = string.Empty;
+
+        public string Title
+        {
+            get => title;
+            set
+            {
+                title = value;
+                WebHostInterop.SetTitle(value);
+            }
+        }
+
+        #endregion
+
+        #region Event processing
+
+        private void processEvents()
+        {
+            while (WebInput.TryDequeue(out var e))
+            {
+                switch (e.Type)
+                {
+                    case WebEventType.Resize:
+                        var newSize = new Size(Math.Max(1, (int)e.X), Math.Max(1, (int)e.Y));
+                        int refreshRate = e.A > 0 ? e.A : (int)MathF.Round(currentDisplayMode.Value.RefreshRate);
+                        bool sizeChanged = newSize != drawableSize;
+                        bool refreshRateChanged = refreshRate != (int)MathF.Round(currentDisplayMode.Value.RefreshRate);
+                        Scale = e.Z;
+
+                        if (sizeChanged || refreshRateChanged)
+                        {
+                            drawableSize = newSize;
+                            currentDisplayMode.Value = new DisplayMode(null, drawableSize, 32, refreshRate, 0);
+
+                            if (sizeChanged)
+                                Resized?.Invoke();
+                        }
+
+                        break;
+
+                    case WebEventType.MouseMove:
+                        MouseMove?.Invoke(new osuTK.Vector2(e.X, e.Y));
+                        break;
+
+                    case WebEventType.MouseMoveRelative:
+                        MouseMoveRelative?.Invoke(new osuTK.Vector2(e.X, e.Y));
+                        break;
+
+                    case WebEventType.MouseDown:
+                        MouseDown?.Invoke(toMouseButton(e.A));
+                        break;
+
+                    case WebEventType.MouseUp:
+                        MouseUp?.Invoke(toMouseButton(e.A));
+                        break;
+
+                    case WebEventType.MouseWheel:
+                        MouseWheel?.Invoke(new osuTK.Vector2(e.X, e.Y), e.A != 0);
+                        break;
+
+                    case WebEventType.MouseEnter:
+                        cursorInWindow.Value = true;
+                        break;
+
+                    case WebEventType.MouseLeave:
+                        cursorInWindow.Value = false;
+                        break;
+
+                    case WebEventType.KeyDown:
+                    {
+                        var key = WebKeyMapping.FromCode(e.Text);
+                        if (key != Key.Unknown)
+                            KeyDown?.Invoke(key);
+                        break;
+                    }
+
+                    case WebEventType.KeyUp:
+                    {
+                        var key = WebKeyMapping.FromCode(e.Text);
+                        if (key != Key.Unknown)
+                            KeyUp?.Invoke(key);
+                        break;
+                    }
+
+                    case WebEventType.TextInput:
+                        if (!string.IsNullOrEmpty(e.Text))
+                            TextInput?.Invoke(e.Text);
+                        break;
+
+                    case WebEventType.TouchStart:
+                        TouchDown?.Invoke(e.A, new osuTK.Vector2(e.X, e.Y));
+                        break;
+
+                    case WebEventType.TouchMove:
+                        TouchMove?.Invoke(e.A, new osuTK.Vector2(e.X, e.Y));
+                        break;
+
+                    case WebEventType.TouchEnd:
+                        TouchUp?.Invoke(e.A, new osuTK.Vector2(e.X, e.Y));
+                        break;
+
+                    case WebEventType.Focus:
+                        isActive.Value = true;
+                        break;
+
+                    case WebEventType.Blur:
+                        isActive.Value = false;
+                        break;
+
+                    case WebEventType.Visibility:
+                    {
+                        bool visible = e.A != 0;
+                        if (isVisible == visible)
+                            break;
+
+                        isVisible = visible;
+
+                        if (visible)
+                            Resumed?.Invoke();
+                        else
+                            Suspended?.Invoke();
+
+                        break;
+                    }
+
+                    case WebEventType.Fullscreen:
+                        WindowMode.Value = e.A != 0 ? Configuration.WindowMode.Fullscreen : Configuration.WindowMode.Windowed;
+                        break;
+
+                    case WebEventType.FileDrop:
+                        if (!string.IsNullOrEmpty(e.Text))
+                        {
+                            if (DragDrop != null)
+                                DragDrop.Invoke(e.Text);
+                            else
+                                WebInput.Discard(e);
+                        }
+                        break;
+                }
+            }
+
+            ensureCanvasSize();
+        }
+
+        private static MouseButton toMouseButton(int domButton)
+        {
+            switch (domButton)
+            {
+                default:
+                    return MouseButton.Left;
+
+                case 1:
+                    return MouseButton.Middle;
+
+                case 2:
+                    return MouseButton.Right;
+
+                case 3:
+                    return MouseButton.Button1;
+
+                case 4:
+                    return MouseButton.Button2;
+            }
+        }
+
+        #endregion
+
+        #region Graphics surface
+
+        public IntPtr WindowHandle => IntPtr.Zero;
+
+        public GraphicsSurfaceType Type => GraphicsSurfaceType.OpenGL;
+
+        void IGraphicsSurface.Initialise()
+        {
+        }
+
+        public Size GetDrawableSize() => drawableSize;
+
+        public bool VerticalSync { get; set; } = true;
+
+        public IntPtr WindowContext => glContext;
+
+        public IntPtr CurrentContext => glContext;
+
+        public int? BackbufferFramebuffer => null;
+
+        public void CreateContext()
+        {
+        }
+
+        private void ensureContext()
+        {
+            if (glContext != 0)
+                return;
+
+            glContext = WebNative.osuweb_gl_create(drawableSize.Width, drawableSize.Height);
+            glCanvasSize = drawableSize;
+
+            if (glContext == 0)
+                throw new InvalidOperationException("Failed to create a WebGL2 context.");
+
+            Logger.Log($"Created WebGL2 context ({drawableSize.Width}x{drawableSize.Height})");
+        }
+
+        private void ensureCanvasSize()
+        {
+            if (glContext == 0 || glCanvasSize == drawableSize)
+                return;
+
+            WebNative.osuweb_gl_resize(drawableSize.Width, drawableSize.Height);
+            glCanvasSize = drawableSize;
+        }
+
+        public void SwapBuffers()
+        {
+            // Frame pacing happens in RunAsync, which waits for the page's next animation frame without blocking.
+            WebNative.osuweb_gl_present();
+        }
+
+        public void MakeCurrent(IntPtr context) => ensureContext();
+
+        public void ClearCurrent()
+        {
+        }
+
+        public void DeleteContext(IntPtr context)
+        {
+            if (glContext == 0)
+                return;
+
+            WebNative.osuweb_gl_destroy();
+            glContext = 0;
+            glCanvasSize = Size.Empty;
+        }
+
+        public IntPtr GetProcAddress(string symbol) => IntPtr.Zero;
+
+        #endregion
+
+        public void Dispose()
+        {
+            if (isDisposed)
+                return;
+
+            isDisposed = true;
+            exitRequested = true;
+            WebInput.Clear();
+            DeleteContext((IntPtr)glContext);
+        }
+    }
+}
+
+#endif
