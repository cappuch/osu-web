@@ -0,0 +1,31 @@
+// Copyright (c) ppy Pty Ltd <contact@ppy.sh>. Licensed under the MIT Licence.
+// See the LICENCE file in the repository root for full licence text.
+
+#if OSU_WEB
+
+using osu.Framework.Audio.Web;
+
+namespace osu.Framework.Audio.Mixing.Web
+{
+    /// <summary>
+    /// An audio channel which can be mixed by a <see cref="WebAudioMixer"/>.
+    /// </summary>
+    internal interface IWebAudioChannel : IAudioChannel
+    {
+        /// <summary>
+        /// Whether this channel is still active within the mix. Inactive channels are removed from their mixer.
+        /// </summary>
+        bool IsActive { get; }
+
+        /// <summary>
+        /// Adds this channel's audio into <paramref name="buffer"/> (interleaved stereo).
+        /// Called from the mixer thread; implementations must synchronise with state changes from other threads.
+        /// </summary>
+        /// <param name="buffer">The buffer to add audio into.</param>
+        /// <param name="scratch">A scratch buffer of at least the same size, for the channel's own use.</param>
+        /// <param name="context">The parameters of the current mix pass.</param>
+        void MixInto(float[] buffer, float[] scratch, in WebMixContext context);
+    }
+}
+
+#endif
diff --git a/osu.Framework/Audio/Mixing/Web/WebAudioMixer.cs b/osu.Framework/Audio/Mixing/Web/WebAudioMixer.cs
new file mode 100644
index 000000000..2582a829e
--- /dev/null
+++ b/osu.Framework/Audio/Mixing/Web/WebAudioMixer.cs
@@ -0,0 +1,208 @@
+// Copyright (c) ppy Pty Ltd <contact@ppy.sh>. Licensed under the MIT Licence.
+// See the LICENCE file in the repository root for full licence text.
+
+#if OSU_WEB
+
+using System;
+using System.Collections.Generic;
+using System.Threading;
+using ManagedBass;
+using ManagedBass.Fx;
+using osu.Framework.Audio.Web;
+using osu.Framework.Statistics;
+
+namespace osu.Framework.Audio.Mixing.Web
+{
+    /// <summary>
+    /// Mixes together multiple <see cref="IWebAudioChannel"/>s into the <see cref="WebAudioEngine"/> output, applying effects.
+    /// </summary>
+    /// <remarks>
+    /// Supported effects: <see cref="BQFParameters"/> (biquad filters). Other effect types are accepted but ignored.
+    /// </remarks>
+    internal class WebAudioMixer : AudioMixer
+    {
+        private readonly Lock channelsLock = new Lock();
+        private readonly List<IWebAudioChannel> channels = new List<IWebAudioChannel>();
+        private volatile IWebAudioChannel[] channelSnapshot = Array.Empty<IWebAudioChannel>();
+
+        private readonly Lock effectsLock = new Lock();
+        private readonly List<EffectEntry> effects = new List<EffectEntry>();
+
+        private readonly float[] mixBuffer = new float[WebAudioEngine.CHUNK_FRAMES * 2];
+        private readonly float[] scratchBuffer = new float[WebAudioEngine.CHUNK_FRAMES * 2];
+
+        /// <summary>
+        /// Creates a new <see cref="WebAudioMixer"/>.
+        /// </summary>
+        /// <param name="fallbackMixer"><inheritdoc /></param>
+        /// <param name="identifier">An identifier displayed on the audio mixer visualiser.</param>
+        public WebAudioMixer(AudioMixer? fallbackMixer, string identifier)
+            : base(fallbackMixer, identifier)
+        {
+            WebAudioEngine.Register(this);
+        }
+
+        /// <summary>
+        /// The channels currently in this mix.
+        /// </summary>
+        internal IReadOnlyList<IWebAudioChannel> Channels => channelSnapshot;
+
+        public override void AddEffect(IEffectParameter effect, int priority = 0)
+        {
+            lock (effectsLock)
+            {
+                if (effects.Exists(e => e.Effect == effect))
+                    return;
+
+                var entry = new EffectEntry(effect, priority);
+                entry.Update();
+
+                // lower priority values are processed first. equal priorities are processed in insertion order.
+                int index = effects.FindIndex(e => e.Priority > priority);
+                if (index < 0)
+                    effects.Add(entry);
+                else
+                    effects.Insert(index, entry);
+            }
+        }
+
+        public override void RemoveEffect(IEffectParameter effect)
+        {
+            lock (effectsLock)
+                effects.RemoveAll(e => e.Effect == effect);
+        }
+
+        public override void UpdateEffect(IEffectParameter effect)
+        {
+            lock (effectsLock)
+                effects.Find(e => e.Effect == effect)?.Update();
+        }
+
+        protected override void AddInternal(IAudioChannel channel)
+        {
+            if (channel is IWebAudioChannel webChannel)
+                AddToMix(webChannel);
+        }
+
+        /// <summary>
+        /// Immediately adds a channel to the mix, if not already present. Safe to call from any thread.
+        /// </summary>
+        /// <remarks>
+        /// Inactive channels are removed from the mix on update, so channels should call this when (re)starting playback.
+        /// </remarks>
+        internal void AddToMix(IWebAudioChannel channel)
+        {
+            lock (channelsLock)
+            {
+                if (channels.Contains(channel))
+                    return;
+
+                channels.Add(channel);
+                channelSnapshot = channels.ToArray();
+            }
+        }
+
+        protected override void RemoveInternal(IAudioChannel channel)
+        {
+            if (channel is IWebAudioChannel webChannel)
+                RemoveFromMix(webChannel);
+        }
+
+        /// <summary>
+        /// Immediately removes a channel from the mix (without returning it to the fallback mixer). Safe to call from any thread.
+        /// </summary>
+        internal void RemoveFromMix(IWebAudioChannel channel)
+        {
+            lock (channelsLock)
+            {
+                if (channels.Remove(channel))
+                    channelSnapshot = channels.ToArray();
+            }
+        }
+
+        /// <summary>
+        /// Frees a channel, removing it from this mixer.
+        /// </summary>
+        internal void StreamFree(IWebAudioChannel channel)
+        {
+            RemoveFromMix(channel);
+            Remove(channel, false);
+        }
+
+        /// <summary>
+        /// Mixes all channels, applies effects and adds the result into <paramref name="output"/>. Called from the mixer thread.
+        /// </summary>
+        internal void MixInto(float[] output, in WebMixContext context)
+        {
+            var currentChannels = channelSnapshot;
+
+            if (currentChannels.Length == 0)
+                return;
+
+            int samples = context.Frames * 2;
+            var mix = mixBuffer.AsSpan(0, samples);
+            mix.Clear();
+
+            for (int i = 0; i < currentChannels.Length; i++)
+                currentChannels[i].MixInto(mixBuffer, scratchBuffer, context);
+
+            lock (effectsLock)
+            {
+                for (int i = 0; i < effects.Count; i++)
+                    effects[i].Filter?.Process(mix, context.Frames, context.SampleRate);
+            }
+
+            for (int i = 0; i < samples; i++)
+                output[i] += mix[i];
+        }
+
+        protected override void UpdateState()
+        {
+            var currentChannels = channelSnapshot;
+
+            for (int i = 0; i < currentChannels.Length; i++)
+            {
+                if (!currentChannels[i].IsActive)
+                    RemoveFromMix(currentChannels[i]);
+            }
+
+            FrameStatistics.Add(StatisticsCounterType.MixChannels, channelSnapshot.Length);
+            base.UpdateState();
+        }
+
+        protected override void Dispose(bool disposing)
+        {
+            base.Dispose(disposing);
+
+            WebAudioEngine.Unregister(this);
+
+            // Move all contained channels back to the default mixer.
+            foreach (var channel in channelSnapshot)
+                Remove(channel);
+        }
+
+        private sealed class EffectEntry
+        {
+            public readonly IEffectParameter Effect;
+            public readonly int Priority;
+            public readonly BiquadFilter? Filter;
+
+            public EffectEntry(IEffectParameter effect, int priority)
+            {
+                Effect = effect;
+                Priority = priority;
+
+                if (effect is BQFParameters)
+                    Filter = new BiquadFilter();
+            }
+
+            public void Update()
+            {
+                if (Effect is BQFParameters parameters)
+                    Filter?.SetParameters(parameters);
+            }
+        }
+    }
+}
+
+#endif
diff --git a/osu.Framework/Audio/Sample/SampleChannelWeb.cs b/osu.Framework/Audio/Sample/SampleChannelWeb.cs
new file mode 100644
index 000000000..6a0fcf3ae
--- /dev/null
+++ b/osu.Framework/Audio/Sample/SampleChannelWeb.cs
@@ -0,0 +1,292 @@
+// Copyright (c) ppy Pty Ltd <contact@ppy.sh>. Licensed under the MIT Licence.
+// See the LICENCE file in the repository root for full licence text.
+
+#if OSU_WEB
+
+using System;
+using System.Threading;
+using osu.Framework.Audio.Mixing.Web;
+using osu.Framework.Audio.Track;
+using osu.Framework.Audio.Web;
+
+namespace osu.Framework.Audio.Sample
+{
+    /// <summary>
+    /// A single playback of a <see cref="SampleWeb"/>.
+    /// </summary>
+    internal sealed class SampleChannelWeb : SampleChannel, IWebAudioChannel
+    {
+        private readonly SampleWeb sample;
+
+        /// <summary>
+        /// Guards the mix state, which is shared with the mixer thread.
+        /// </summary>
+        private readonly Lock stateLock = new Lock();
+
+        private readonly PcmRenderer? renderer;
+
+        /// <summary>
+        /// Whether the channel is currently playing.
+        /// </summary>
+        /// <remarks>
+        /// This is set to <c>true</c> immediately upon <see cref="Play"/>, but the channel may not be audibly playing yet.
+        /// </remarks>
+        public override bool Playing
+        {
+            get
+            {
+                // Match SampleChannelBass: looping channels are playing for as long as the user wants them to be.
+                if (Looping && userRequestedPlay)
+                    return true;
+
+                return playing || enqueuedPlaybackStart;
+            }
+        }
+
+        private volatile bool playing;
+
+        /// <summary>
+        /// <c>true</c> if the user last called <see cref="Play"/>.
+        /// <c>false</c> if the user last called <see cref="Stop"/>.
+        /// </summary>
+        private volatile bool userRequestedPlay;
+
+        /// <summary>
+        /// Whether the playback start has been enqueued.
+        /// </summary>
+        private volatile bool enqueuedPlaybackStart;
+
+        /// <summary>
+        /// Whether the channel is being mixed (i.e. playing, possibly paused via zero frequency).
+        /// </summary>
+        private volatile bool mixing;
+
+        /// <summary>
+        /// Whether playback has naturally reached the end (or was overridden). Such channels can't be played again.
+        /// </summary>
+        private bool ended;
+
+        private double frequency = 1;
+        private float gainLeft = 1;
+        private float gainRight = 1;
+        private GainRamp gainRamp;
+
+        private AmplitudeAnalyser? amplitudeAnalyser;
+        private volatile bool amplitudesRequested;
+        private ChannelAmplitudes currentAmplitudes = ChannelAmplitudes.Empty;
+
+        /// <summary>
+        /// Creates a new <see cref="SampleChannelWeb"/>.
+        /// </summary>
+        /// <param name="sample">The <see cref="SampleWeb"/> to create the channel from.</param>
+        public SampleChannelWeb(SampleWeb sample)
+            : base(sample.Name)
+        {
+            this.sample = sample;
+
+            if (sample.Factory.Data != null)
+                renderer = new PcmRenderer(sample.Factory.Data);
+        }
+
+        /// <summary>
+        /// Whether this channel is currently being mixed.
+        /// </summary>
+        internal bool IsMixing => mixing;
+
+        public override ChannelAmplitudes CurrentAmplitudes
+        {
+            get
+            {
+                amplitudesRequested = true;
+                return currentAmplitudes;
+            }
+        }
+
+        protected override void UpdateState()
+        {
+            playing = mixing;
+
+            base.UpdateState();
+
+            if (amplitudesRequested)
+                updateAmplitudes();
+        }
+
+        public override void Play()
+        {
+            // Check if this channel is disposed first to not set enqueuedPlaybackStart to true, as it makes Playing true.
+            ObjectDisposedException.ThrowIf(IsDisposed, this);
+
+            userRequestedPlay = true;
+
+            // Pin Playing and IsAlive to true so that the channel isn't killed by the next update. This is only reset after playback is started.
+            enqueuedPlaybackStart = true;
+
+            // Bring this channel alive, allowing it to receive updates.
+            base.Play();
+
+            EnqueueAction(() =>
+            {
+                if (playInternal())
+                    playing = true;
+
+                enqueuedPlaybackStart = false;
+            });
+        }
+
+        public override void Stop()
+        {
+            userRequestedPlay = false;
+
+            base.Stop();
+
+            EnqueueAction(() =>
+            {
+                lock (stateLock)
+                    mixing = false;
+
+                playing = false;
+                sample.Factory.UnregisterPlayback(this);
+            });
+        }
+
+        /// <summary>
+        /// Stops this channel as a result of the sample's playback concurrency being exceeded.
+        /// </summary>
+        internal void StopOverridden()
+        {
+            lock (stateLock)
+            {
+                mixing = false;
+                ended = true;
+            }
+
+            userRequestedPlay = false;
+        }
+
+        private bool playInternal()
+        {
+            if (renderer == null)
+                return false;
+
+            // Ensure state is correct before starting.
+            InvalidateState();
+
+            lock (stateLock)
+            {
+                // Don't restart a sample which has reached its end, matching SampleChannelBass.
+                if (ended)
+                    return false;
+
+                if (mixing)
+                    return true;
+
+                mixing = true;
+            }
+
+            // The channel may have been removed from the mix while it was inactive (i.e. before being played).
+            webMixer?.AddToMix(this);
+
+            sample.Factory.RegisterPlayback(this);
+            return true;
+        }
+
+        internal override void OnStateChanged()
+        {
+            base.OnStateChanged();
+
+            GainRamp.ComputeGains(AggregateVolume.Value, AggregateBalance.Value, out float left, out float right);
+
+            lock (stateLock)
+            {
+                gainLeft = left;
+                gainRight = right;
+                frequency = Math.Max(0, AggregateFrequency.Value);
+            }
+        }
+
+        private void updateAmplitudes()
+        {
+            var data = sample.Factory.Data;
+
+            if (data == null || renderer == null || !mixing)
+            {
+                currentAmplitudes = ChannelAmplitudes.Empty;
+                return;
+            }
+
+            long frame;
+            lock (stateLock)
+                frame = (long)renderer.Position;
+
+            amplitudeAnalyser ??= new AmplitudeAnalyser();
+            currentAmplitudes = amplitudeAnalyser.Compute(data, frame);
+        }
+
+        #region Mixing
+
+        bool IWebAudioChannel.IsActive => IsAlive;
+
+        void IWebAudioChannel.MixInto(float[] buffer, float[] scratch, in WebMixContext context)
+        {
+            lock (stateLock)
+            {
+                if (!mixing || renderer == null || frequency <= 0 || IsDisposed)
+                    return;
+
+                long endFrame = renderer.Data.TotalFrames;
+                int frames = context.Frames;
+                int done = 0;
+                int emptyRenders = 0;
+
+                while (done < frames)
+                {
+                    int rendered = renderer.Render(scratch.AsSpan(done * 2), frames - done, context.SampleRate, frequency, 1, endFrame, out _);
+                    done += rendered;
+
+                    if (done >= frames)
+                        break;
+
+                    // The end of the sample has been reached.
+                    if (Looping && endFrame > 0)
+                    {
+                        // guard against degenerate cases producing no audio at all.
+                        if (rendered == 0 && ++emptyRenders > 1)
+                            break;
+
+                        renderer.SetPosition(0);
+                        continue;
+                    }
+
+                    mixing = false;
+                    ended = true;
+                    break;
+                }
+
+                gainRamp.MixInto(scratch, buffer, done, gainLeft, gainRight);
+            }
+        }
+
+        private WebAudioMixer? webMixer => Mixer as WebAudioMixer;
+
+        #endregion
+
+        protected override void Dispose(bool disposing)
+        {
+            if (IsDisposed)
+                return;
+
+            lock (stateLock)
+                mixing = false;
+
+            sample.Factory.UnregisterPlayback(this);
+            webMixer?.StreamFree(this);
+
+            playing = false;
+
+            base.Dispose(disposing);
+        }
+    }
+}
+
+#endif
