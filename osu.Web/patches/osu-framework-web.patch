+
+                var fft = new Fft(fft_size);
+                float[] fftInput = new float[fft_size];
+                float[] bins = new float[fft_bins];
+                int fftFill = 0;
+
+                float[] buffer = new float[decode_frames * sourceChannels];
+
+                var point = new Point();
+                int pointFill = 0;
+
+                int framesRead;
+
+                while ((framesRead = decoder.Read(buffer, decode_frames)) > 0)
+                {
+                    token.ThrowIfCancellationRequested();
+
+                    for (int f = 0; f < framesRead; f++)
+                    {
+                        float left = buffer[f * sourceChannels];
+                        float right = buffer[f * sourceChannels + secondChannelIndex];
+
+                        point.AmplitudeLeft = Math.Max(point.AmplitudeLeft, Math.Abs(left));
+                        point.AmplitudeRight = Math.Max(point.AmplitudeRight, Math.Abs(right));
+
+                        if (++pointFill == framesPerPoint)
+                        {
+                            points.Add(clip(point));
+                            point = new Point();
+                            pointFill = 0;
+                        }
+
+                        float mono = 0;
+                        for (int c = 0; c < sourceChannels; c++)
+                            mono += buffer[f * sourceChannels + c];
+                        fftInput[fftFill++] = mono / sourceChannels;
+
+                        if (fftFill == fft_size)
+                        {
+                            addBlock();
+                            fftFill = 0;
+                        }
+                    }
+                }
+
+                if (pointFill > 0)
+                    points.Add(clip(point));
+
+                if (fftFill > 0)
+                {
+                    Array.Clear(fftInput, fftFill, fft_size - fftFill);
+                    addBlock();
+                }
+
+                // each point takes the intensities of the FFT block containing its first frame.
+                for (int i = 0; i < points.Count; i++)
+                {
+                    token.ThrowIfCancellationRequested();
+
+                    int block = (int)Math.Min(blockIntensities.Count - 1, (long)i * framesPerPoint / fft_size);
+                    if (block < 0)
+                        break;
+
+                    var p = points[i];
+                    (p.LowIntensity, p.MidIntensity, p.HighIntensity) = blockIntensities[block];
+                    points[i] = p;
+                }
+
+                channels = sourceChannels;
+                computedPoints = points.ToArray();
+
+                void addBlock()
+                {
+                    fft.ComputeMagnitudes(fftInput, bins);
+                    blockIntensities.Add((
+                        computeIntensity(decoder.SampleRate, bins, low_min, mid_min),
+                        computeIntensity(decoder.SampleRate, bins, mid_min, high_min),
+                        computeIntensity(decoder.SampleRate, bins, high_min, high_max)));
+                }
+            }
+
+            static Point clip(Point p)
+            {
+                p.AmplitudeLeft = Math.Min(1, p.AmplitudeLeft);
+                p.AmplitudeRight = Math.Min(1, p.AmplitudeRight);
+                return p;
+            }
+        }
+#endif
+
+#if OSU_WEB
+        private static float computeIntensity(int sampleRate, float[] bins, float startFrequency, float endFrequency)
+        {
+            int startBin = (int)(fft_bins * 2 * startFrequency / sampleRate);
+            int endBin = (int)(fft_bins * 2 * endFrequency / sampleRate);
+#else
         private float computeIntensity(ChannelInfo info, float[] bins, float startFrequency, float endFrequency)
         {
             int startBin = (int)(fft_bins * 2 * startFrequency / info.Frequency);
             int endBin = (int)(fft_bins * 2 * endFrequency / info.Frequency);
+#endif
 
             startBin = Math.Clamp(startBin, 0, bins.Length);
             endBin = Math.Clamp(endBin, 0, bins.Length);
