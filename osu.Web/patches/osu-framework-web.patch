diff --git a/osu.Framework/Audio/Web/WebAudioOutput.cs b/osu.Framework/Audio/Web/WebAudioOutput.cs
new file mode 100644
index 000000000..083dea1c0
--- /dev/null
+++ b/osu.Framework/Audio/Web/WebAudioOutput.cs
@@ -0,0 +1,216 @@
+// Copyright (c) ppy Pty Ltd <contact@ppy.sh>. Licensed under the MIT Licence.
+// See the LICENCE file in the repository root for full licence text.
+
+#if OSU_WEB
+
+using System;
+using System.Diagnostics;
+using System.Numerics;
+using System.Runtime.InteropServices;
+using System.Threading;
+
+namespace osu.Framework.Audio.Web
+{
+    /// <summary>
+    /// A destination for mixed audio. Tracks frame counters used for latency compensation.
+    /// </summary>
+    /// <remarks>
+    /// Frame counters are 32-bit and wrap naturally; differences between them must be computed with wrapping (unchecked) arithmetic.
+    /// </remarks>
+    internal abstract class WebAudioOutput
+    {
+        /// <summary>
+        /// The output sample rate in Hz.
+        /// </summary>
+        public abstract int SampleRate { get; }
+
+        /// <summary>
+        /// The capacity of the output buffer in frames. At most this many frames may be buffered at once.
+        /// </summary>
+        public abstract int CapacityFrames { get; }
+
+        /// <summary>
+        /// The total number of frames written.
+        /// </summary>
+        public abstract int WriteFrame { get; }
+
+        /// <summary>
+        /// The total number of frames that have been played (consumed by the audio device).
+        /// </summary>
+        public abstract int ReadFrame { get; }
+
+        /// <summary>
+        /// Writes interleaved stereo frames. Callers must ensure there is space available (<see cref="CapacityFrames"/>).
+        /// </summary>
+        public abstract void Write(ReadOnlySpan<float> interleaved, int frames);
+
+        /// <summary>
+        /// The number of frames written but not yet played.
+        /// </summary>
+        public int BufferedFrames => Math.Max(0, unchecked(WriteFrame - ReadFrame));
+    }
+
+    /// <summary>
+    /// Outputs audio to the page's AudioWorklet through a single-producer single-consumer ring buffer in (shared) WebAssembly memory.
+    /// </summary>
+    /// <remarks>
+    /// <para>
+    /// Memory layout (allocated once, never moved or freed; all values little-endian):
+    /// <code>
+    /// offset 0:  int32 writeFrame     - total frames ever written. Written only by C# (after the sample data), wraps naturally.
+    /// offset 4:  int32 readFrame      - total frames ever consumed. Written only by the worklet (JS), wraps naturally.
+    /// offset 8:  int32 capacityFrames - ring capacity in stereo frames, a power of two. Constant.
+    /// offset 12: int32 sampleRate     - sample rate of the data, in Hz. Constant.
+    /// offset 16: float32[capacityFrames * 2] - interleaved stereo samples (L, R, L, R, ...).
+    /// </code>
+    /// Frame <c>n</c> is stored at sample index <c>(n &amp; (capacityFrames - 1)) * 2</c> (left) and <c>+ 1</c> (right).
+    /// </para>
+    /// <para>
+    /// The worklet should, per render quantum: read <c>writeFrame</c> with <c>Atomics.load</c>, compute <c>available = (writeFrame - readFrame) | 0</c>,
+    /// copy <c>min(available, quantum)</c> frames, output silence for the remainder (underrun), and publish the new <c>readFrame</c> with <c>Atomics.store</c>.
+    /// It must never advance <c>readFrame</c> beyond <c>writeFrame</c>. The C# side never writes more than <c>capacityFrames</c> frames ahead of <c>readFrame</c>.
+    /// </para>
+    /// <para>
+    /// The page must implement <c>globalThis.osuweb.audioGetSampleRate(): number</c> and
+    /// <c>globalThis.osuweb.audioAttach(bufferPointer: number, capacityFrames: number, sampleRate: number): void</c> (see <see cref="WebAudioInterop"/>).
+    /// </para>
+    /// </remarks>
+    internal sealed unsafe class RingBufferAudioOutput : WebAudioOutput
+    {
+        private const int header_ints = 4;
+
+        private readonly int* header;
+        private readonly float* samples;
+        private readonly int mask;
+
+        public override int SampleRate { get; }
+
+        public override int CapacityFrames { get; }
+
+        public RingBufferAudioOutput(int sampleRate, int minimumCapacityFrames)
+        {
+            SampleRate = sampleRate;
+            CapacityFrames = (int)BitOperations.RoundUpToPowerOf2((uint)Math.Max(256, minimumCapacityFrames));
+            mask = CapacityFrames - 1;
+
+            header = (int*)NativeMemory.AllocZeroed((nuint)(header_ints * sizeof(int) + CapacityFrames * 2 * sizeof(float)));
+            samples = (float*)(header + header_ints);
+
+            header[2] = CapacityFrames;
+            header[3] = SampleRate;
+            Thread.MemoryBarrier();
+        }
+
+        /// <summary>
+        /// The address of the ring buffer (valid for wasm32).
+        /// </summary>
+        public int Address => (int)(nint)header;
+
+        public override int WriteFrame => Volatile.Read(ref header[0]);
+
+        public override int ReadFrame => Volatile.Read(ref header[1]);
+
+        public override void Write(ReadOnlySpan<float> interleaved, int frames)
+        {
+            int write = header[0];
+
+            for (int i = 0; i < frames;)
+            {
+                int index = unchecked(write + i) & mask;
+                int count = Math.Min(frames - i, CapacityFrames - index);
+
+                interleaved.Slice(i * 2, count * 2).CopyTo(new Span<float>(samples + index * 2, count * 2));
+                i += count;
+            }
+
+            Volatile.Write(ref header[0], unchecked(write + frames));
+        }
+    }
+
+    /// <summary>
+    /// An output which discards audio but consumes it in real-time, keeping playback clocks running when no audio device is available.
+    /// </summary>
+    internal sealed class NullAudioOutput : WebAudioOutput
+    {
+        private readonly Lock syncRoot = new Lock();
+        private readonly Stopwatch stopwatch = Stopwatch.StartNew();
+
+        private int writeFrame;
+        private int readFrame;
+        private long lastTicks;
+        private double fractionalFrames;
+
+        public override int SampleRate { get; }
+
+        public override int CapacityFrames { get; }
+
+        public NullAudioOutput(int sampleRate, int capacityFrames)
+        {
+            SampleRate = sampleRate;
+            CapacityFrames = capacityFrames;
+        }
+
+        public override int WriteFrame => Volatile.Read(ref writeFrame);
+
+        public override int ReadFrame
+        {
+            get
+            {
+                lock (syncRoot)
+                {
+                    long ticks = stopwatch.ElapsedTicks;
+                    fractionalFrames += (ticks - lastTicks) * (double)SampleRate / Stopwatch.Frequency;
+                    lastTicks = ticks;
+
+                    int buffered = unchecked(Volatile.Read(ref writeFrame) - readFrame);
+                    int advance = (int)Math.Min(buffered, Math.Floor(fractionalFrames));
+
+                    // when starved, time does not accumulate (matching the behaviour of a real device which outputs silence on underrun).
+                    fractionalFrames = advance < buffered ? fractionalFrames - advance : 0;
+                    readFrame = unchecked(readFrame + advance);
+
+                    return readFrame;
+                }
+            }
+        }
+
+        public override void Write(ReadOnlySpan<float> interleaved, int frames) => Interlocked.Add(ref writeFrame, frames);
+    }
+
+    /// <summary>
+    /// An output which is pulled manually (see <see cref="WebAudioEngine.RenderOffline"/>). Written audio is considered to be played immediately.
+    /// </summary>
+    internal sealed class OfflineAudioOutput : WebAudioOutput
+    {
+        private int writeFrame;
+
+        public float[]? Destination;
+        public int DestinationOffset;
+
+        public override int SampleRate { get; }
+
+        public override int CapacityFrames => int.MaxValue;
+
+        public OfflineAudioOutput(int sampleRate)
+        {
+            SampleRate = sampleRate;
+        }
+
+        public override int WriteFrame => Volatile.Read(ref writeFrame);
+
+        public override int ReadFrame => Volatile.Read(ref writeFrame);
+
+        public override void Write(ReadOnlySpan<float> interleaved, int frames)
+        {
+            if (Destination != null)
+            {
+                interleaved[..(frames * 2)].CopyTo(Destination.AsSpan(DestinationOffset * 2));
+                DestinationOffset += frames;
+            }
+
+            Interlocked.Add(ref writeFrame, frames);
+        }
+    }
+}
+
+#endif
